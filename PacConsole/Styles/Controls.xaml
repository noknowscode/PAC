<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Console control styles. One template shape for every clickable thing: a matte filled surface
    with no outline (the palette's tonal pair, SecondaryContainer and its On colour), plus an ink state layer
    (OnSurface) that reads +6% on hover and +10% on press. Checked raises the control to the Surface with
    Primary text (the selection colour). Focus uses system focus visuals in Primary. Every colour is a role
    brush of the theme, so the palette (Styles/ColorPaletteOverride.xaml) restyles them.
    Templates rather than the theme's button styles: Simple's state keys swap one fill per state and per
    variant, while this look is one ink layer over whatever fill a variant has, in both themes.
  -->

  <Style x:Key="ConsoleButtonBase" TargetType="ButtonBase">
    <Setter Property="Background" Value="{ThemeResource SecondaryContainerBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius200CornerRadius}" />
    <Setter Property="Foreground" Value="{ThemeResource OnSecondaryContainerBrush}" />
    <Setter Property="FontFamily" Value="{ThemeResource LabelMediumFontFamily}" />
    <Setter Property="FontSize" Value="{ThemeResource LabelMediumFontSize}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Padding" Value="{StaticResource Space150HorizontalThickness}" />
    <Setter Property="MinHeight" Value="{StaticResource ControlHeightSmall}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource PrimaryBrush}" />
    <Setter Property="FocusVisualPrimaryThickness" Value="2" />
    <Setter Property="FocusVisualSecondaryThickness" Value="0" />
    <Setter Property="FocusVisualMargin" Value="-3" />
  </Style>

  <Style x:Key="ConsoleButton" TargetType="Button" BasedOn="{StaticResource ConsoleButtonBase}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
            <Border x:Name="StateLayer"
                    Background="{ThemeResource OnSurfaceBrush}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Opacity="0" />
            <ContentPresenter x:Name="Presenter"
                              Padding="{TemplateBinding Padding}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="StateLayer.Opacity" Value="0.06" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="StateLayer.Opacity" Value="0.10" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Presenter.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The primary action (Confirm in the select-before-operate bar): the accent and its ink, the palette's Primary pair. -->
  <Style x:Key="ConsolePrimaryButton" TargetType="Button" BasedOn="{StaticResource ConsoleButton}">
    <Setter Property="Background" Value="{ThemeResource PrimaryBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource OnPrimaryBrush}" />
  </Style>
  <!-- A button raised on a tinted ground (Acknowledge on the alarm response, Cancel on the pending bar): the Surface pair. -->
  <Style x:Key="ConsoleSurfaceButton" TargetType="Button" BasedOn="{StaticResource ConsoleButton}">
    <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
  </Style>

  <!-- Checkable version: used by ToggleButton (auto orbit). -->
  <ControlTemplate x:Key="ConsoleCheckableTemplate" TargetType="ToggleButton">
    <Grid x:Name="Root"
          Background="{TemplateBinding Background}"
          BorderBrush="{TemplateBinding BorderBrush}"
          BorderThickness="{TemplateBinding BorderThickness}"
          CornerRadius="{TemplateBinding CornerRadius}">
      <Border x:Name="StateLayer"
              Background="{ThemeResource OnSurfaceBrush}"
              CornerRadius="{TemplateBinding CornerRadius}"
              Opacity="0" />
      <ContentPresenter x:Name="Presenter"
                        Padding="{TemplateBinding Padding}"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        Foreground="{TemplateBinding Foreground}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal" />
          <VisualState x:Name="PointerOver">
            <VisualState.Setters>
              <Setter Target="StateLayer.Opacity" Value="0.06" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Pressed">
            <VisualState.Setters>
              <Setter Target="StateLayer.Opacity" Value="0.10" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Disabled">
            <VisualState.Setters>
              <Setter Target="Presenter.Opacity" Value="0.4" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Checked">
            <VisualState.Setters>
              <Setter Target="Root.Background" Value="{ThemeResource SurfaceBrush}" />
              <Setter Target="Presenter.Foreground" Value="{ThemeResource PrimaryBrush}" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="CheckedPointerOver">
            <VisualState.Setters>
              <Setter Target="Root.Background" Value="{ThemeResource SurfaceBrush}" />
              <Setter Target="Presenter.Foreground" Value="{ThemeResource PrimaryBrush}" />
              <Setter Target="StateLayer.Opacity" Value="0.06" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="CheckedPressed">
            <VisualState.Setters>
              <Setter Target="Root.Background" Value="{ThemeResource SurfaceBrush}" />
              <Setter Target="Presenter.Foreground" Value="{ThemeResource PrimaryBrush}" />
              <Setter Target="StateLayer.Opacity" Value="0.10" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="CheckedDisabled">
            <VisualState.Setters>
              <Setter Target="Presenter.Opacity" Value="0.4" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Indeterminate" />
          <VisualState x:Name="IndeterminatePointerOver" />
          <VisualState x:Name="IndeterminatePressed" />
          <VisualState x:Name="IndeterminateDisabled" />
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
    </Grid>
  </ControlTemplate>

  <Style x:Key="ConsoleToggleButton" TargetType="ToggleButton" BasedOn="{StaticResource ConsoleButtonBase}">
    <Setter Property="Template" Value="{StaticResource ConsoleCheckableTemplate}" />
  </Style>

  <!--
    Text inside a control (a button's label) must take the control's Foreground. Simple's implicit
    TextBlock style sets Foreground locally, which beats inheritance, so such text kept Simple's ink
    (dark theme: #DFF5FF) instead of the accent or alert colour. An explicit style replaces the
    implicit one, and with no Foreground setter the label inherits again.
  -->
  <Style x:Key="ControlLabel" TargetType="TextBlock" />

  <!-- Valve labels: no Foreground setter, so the toggle's checked/unchecked ink still applies.
       The state line is one size smaller instead of faded (text opacity breaks contrast). -->
  <Style x:Key="ValveNumber" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{ThemeResource LabelSmallFontFamily}" />
    <Setter Property="FontSize" Value="{ThemeResource LabelSmallFontSize}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style x:Key="ValveState" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{ThemeResource BodySmallFontFamily}" />
    <Setter Property="FontSize" Value="{ThemeResource BodySmallFontSize}" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>

  <!-- RadioButton template: same look, RadioButton's own state names (CheckStates group). -->
  <Style x:Key="ConsoleRadioButton" TargetType="RadioButton" BasedOn="{StaticResource ConsoleButtonBase}">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid x:Name="Root"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
            <Border x:Name="StateLayer"
                    Background="{ThemeResource OnSurfaceBrush}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Opacity="0" />
            <ContentPresenter x:Name="Presenter"
                              Padding="{TemplateBinding Padding}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="StateLayer.Opacity" Value="0.06" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="StateLayer.Opacity" Value="0.10" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Presenter.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="CheckStates">
                <VisualState x:Name="Checked">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource SurfaceBrush}" />
                    <Setter Target="Presenter.Foreground" Value="{ThemeResource PrimaryBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Unchecked" />
                <VisualState x:Name="Indeterminate" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ModeRadioButton" TargetType="RadioButton" BasedOn="{StaticResource ConsoleRadioButton}">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Height" Value="{StaticResource ControlHeightSmall}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius100CornerRadius}" />
    <Setter Property="Padding" Value="{StaticResource Space125HorizontalThickness}" />
    <Setter Property="GroupName" Value="Mode" />
  </Style>

  <!--
    Segmented choices that set a view (systems, standard views, trend range): the chosen segment fills
    with the soft fill and ink text, because it is a filter, not the selection colour.
  -->
  <Style x:Key="SegmentRadioButton" TargetType="RadioButton" BasedOn="{StaticResource ConsoleButtonBase}">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Height" Value="{StaticResource ControlHeightSmall}" />
    <Setter Property="Padding" Value="{StaticResource Space150HorizontalThickness}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius100CornerRadius}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{ThemeResource SecondaryBrush}" />
    <Setter Property="FontFamily" Value="{ThemeResource BodyMediumFontFamily}" />
    <Setter Property="FontSize" Value="{ThemeResource BodyMediumFontSize}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid x:Name="Root"
                Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}">
            <Border x:Name="StateLayer"
                    Background="{ThemeResource OnSurfaceBrush}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Opacity="0" />
            <ContentPresenter x:Name="Presenter"
                              Padding="{TemplateBinding Padding}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              FontFamily="{TemplateBinding FontFamily}"
                              FontWeight="{TemplateBinding FontWeight}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="StateLayer.Opacity" Value="0.05" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="StateLayer.Opacity" Value="0.09" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Presenter.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="CheckStates">
                <VisualState x:Name="Checked">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource SecondaryContainerBrush}" />
                    <Setter Target="Presenter.Foreground" Value="{ThemeResource OnSecondaryContainerBrush}" />
                    <Setter Target="Presenter.FontWeight" Value="Medium" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Unchecked" />
                <VisualState x:Name="Indeterminate" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ViewRadioButton" TargetType="RadioButton" BasedOn="{StaticResource SegmentRadioButton}">
    <Setter Property="Height" Value="{StaticResource SegmentHeightCompact}" />
    <Setter Property="Padding" Value="{StaticResource Space125HorizontalThickness}" />
  </Style>

  <!--
    A view thumbnail beside the plant: the plant from one standard camera over its name, straight on the
    panel ground. The view the camera rests in takes the accent outline and ink label; the others a frame.
  -->
  <Style x:Key="ThumbRadioButton" TargetType="RadioButton" BasedOn="{StaticResource ConsoleButtonBase}">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius200CornerRadius}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{ThemeResource OutlineLowBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
    <Setter Property="FontFamily" Value="{ThemeResource BodyMediumFontFamily}" />
    <Setter Property="FontSize" Value="{ThemeResource BodyMediumFontSize}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <!-- xaml-lint: allow card - a selectable tile's frame (hairline, accent when chosen), not a content surface. -->
          <Border x:Name="Frame"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <Grid>
              <Border x:Name="StateLayer" Background="{ThemeResource OnSurfaceBrush}" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" />
              <ContentPresenter x:Name="Presenter"
                                Padding="{TemplateBinding Padding}"
                                Content="{TemplateBinding Content}"
                                Foreground="{TemplateBinding Foreground}"
                                FontFamily="{TemplateBinding FontFamily}"
                                FontWeight="{TemplateBinding FontWeight}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Grid>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="StateLayer.Opacity" Value="0.04" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="StateLayer.Opacity" Value="0.08" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled" />
              </VisualStateGroup>
              <VisualStateGroup x:Name="CheckStates">
                <VisualState x:Name="Checked">
                  <VisualState.Setters>
                    <Setter Target="Frame.BorderBrush" Value="{ThemeResource PrimaryBrush}" />
                    <Setter Target="Presenter.Foreground" Value="{ThemeResource OnSurfaceBrush}" />
                    <Setter Target="Presenter.FontWeight" Value="Medium" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Unchecked" />
                <VisualState x:Name="Indeterminate" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Inspector tabs: text with a 2 px slate-teal underline on the open tab. -->
  <Style x:Key="TabRadioButton" TargetType="RadioButton" BasedOn="{StaticResource ConsoleButtonBase}">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Height" Value="{StaticResource TabHeight}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
    <Setter Property="FontFamily" Value="{ThemeResource BodyMediumFontFamily}" />
    <Setter Property="FontSize" Value="{ThemeResource BodyMediumFontSize}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid x:Name="Root" Background="Transparent">
            <ContentPresenter x:Name="Presenter"
                              Padding="{TemplateBinding Padding}"
                              Content="{TemplateBinding Content}"
                              Foreground="{TemplateBinding Foreground}"
                              FontFamily="{TemplateBinding FontFamily}"
                              FontWeight="{TemplateBinding FontWeight}"
                              VerticalContentAlignment="Center" />
            <Border x:Name="Indicator" Height="2" VerticalAlignment="Bottom" Background="{ThemeResource PrimaryBrush}" Opacity="0" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Presenter.Foreground" Value="{ThemeResource OnSurfaceBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Presenter.Foreground" Value="{ThemeResource OnSurfaceBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Presenter.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="CheckStates">
                <VisualState x:Name="Checked">
                  <VisualState.Setters>
                    <Setter Target="Indicator.Opacity" Value="1" />
                    <Setter Target="Presenter.Foreground" Value="{ThemeResource OnSurfaceBrush}" />
                    <Setter Target="Presenter.FontWeight" Value="Medium" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Unchecked" />
                <VisualState x:Name="Indeterminate" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource ConsoleButton}">
    <Setter Property="Width" Value="{StaticResource ControlHeightSmall}" />
    <Setter Property="Height" Value="{StaticResource ControlHeightSmall}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{ThemeResource SecondaryBrush}" />
  </Style>

  <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource ConsoleButton}">
    <Setter Property="Height" Value="{StaticResource ControlHeightSmall}" />
    <Setter Property="Padding" Value="{StaticResource Space125HorizontalThickness}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{ThemeResource SecondaryBrush}" />
  </Style>

  <Style x:Key="ToolbarToggleButton" TargetType="ToggleButton" BasedOn="{StaticResource ConsoleToggleButton}">
    <Setter Property="Height" Value="{StaticResource ControlHeightSmall}" />
    <Setter Property="Padding" Value="{StaticResource Space125HorizontalThickness}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{ThemeResource SecondaryBrush}" />
  </Style>

  <!--
    Touch variants: the same look with a 44 px target (ControlHeightMediumLarge). The page picks them below 960 px, the Narrow and
    Normal categories of ConsoleLayout, with {utu:Responsive Narrow=…Touch, Wide=…}; a Style cannot hold a responsive
    value itself.
  -->
  <Style x:Key="ConsoleButtonTouch" TargetType="Button" BasedOn="{StaticResource ConsoleButton}">
    <Setter Property="MinHeight" Value="{StaticResource ControlHeightMediumLarge}" />
  </Style>
  <Style x:Key="ConsolePrimaryButtonTouch" TargetType="Button" BasedOn="{StaticResource ConsolePrimaryButton}">
    <Setter Property="MinHeight" Value="{StaticResource ControlHeightMediumLarge}" />
  </Style>
  <Style x:Key="ConsoleSurfaceButtonTouch" TargetType="Button" BasedOn="{StaticResource ConsoleSurfaceButton}">
    <Setter Property="MinHeight" Value="{StaticResource ControlHeightMediumLarge}" />
  </Style>
  <Style x:Key="IconButtonTouch" TargetType="Button" BasedOn="{StaticResource IconButton}">
    <Setter Property="Width" Value="{StaticResource ControlHeightMediumLarge}" />
    <Setter Property="Height" Value="{StaticResource ControlHeightMediumLarge}" />
  </Style>
  <Style x:Key="ToolbarButtonTouch" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
    <Setter Property="Height" Value="{StaticResource ControlHeightMediumLarge}" />
    <Setter Property="MinWidth" Value="{StaticResource ControlHeightMediumLarge}" />
  </Style>
  <Style x:Key="ToolbarToggleButtonTouch" TargetType="ToggleButton" BasedOn="{StaticResource ToolbarToggleButton}">
    <Setter Property="Height" Value="{StaticResource ControlHeightMediumLarge}" />
  </Style>
  <Style x:Key="SegmentRadioButtonTouch" TargetType="RadioButton" BasedOn="{StaticResource SegmentRadioButton}">
    <Setter Property="Height" Value="{StaticResource ControlHeightMediumLarge}" />
  </Style>
  <!-- The view switcher's segments, sharing the switcher's width equally. -->
  <Style x:Key="ViewRadioButtonTouch" TargetType="RadioButton" BasedOn="{StaticResource ViewRadioButton}">
    <Setter Property="Height" Value="{StaticResource ControlHeightMediumLarge}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style x:Key="TabRadioButtonTouch" TargetType="RadioButton" BasedOn="{StaticResource TabRadioButton}">
    <Setter Property="Height" Value="{StaticResource ControlHeightMediumLarge}" />
  </Style>

  <!-- Hairline rules between the console's sections, and the vertical one in the header. -->
  <Style x:Key="Rule" TargetType="Border">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{ThemeResource OutlineVariantBrush}" />
  </Style>
  <Style x:Key="VerticalRule" TargetType="Border">
    <Setter Property="Width" Value="1" />
    <Setter Property="Background" Value="{ThemeResource OutlineVariantBrush}" />
  </Style>

  <!-- Figure callout in the plant view: a quiet label plate at the end of a hairline leader, at least 24 px tall
       (the WCAG 2.2 minimum target) and taller when the system text size is. Its size is measured, not set, and the
       tag layout spaces the plates by it. Brushes are set per state in code; the selected plate turns orange. -->
  <Style x:Key="TagButton" TargetType="Button" BasedOn="{StaticResource ConsoleButton}">
    <Setter Property="MinHeight" Value="{StaticResource TagMinHeight}" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="{StaticResource Space075HorizontalThickness}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius100CornerRadius}" />
    <Setter Property="FontSize" Value="{ThemeResource LabelSmallFontSize}" />
  </Style>

</ResourceDictionary>
