<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Console control styles. One template shape for every clickable thing: a bordered surface
    plus a cyan state layer that reads +8% on hover and +14% on press. Selected / checked adds
    the accent border and an 18% accent fill. Focus uses system focus visuals in the accent.
  -->

  <Style x:Key="CardStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
    <Setter Property="Padding" Value="12" />
  </Style>

  <Style x:Key="ConsoleButtonBase" TargetType="ButtonBase">
    <Setter Property="Background" Value="{StaticResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDefault}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
    <Setter Property="Foreground" Value="{StaticResource CyanBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource MonoMediumFont}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="FocusVisualPrimaryThickness" Value="2" />
    <Setter Property="FocusVisualSecondaryThickness" Value="0" />
    <Setter Property="FocusVisualMargin" Value="-3" />
  </Style>

  <Style x:Key="ConsoleButton" TargetType="Button" BasedOn="{StaticResource ConsoleButtonBase}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
            <Border x:Name="StateLayer"
                    Background="{StaticResource CyanBrush}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Opacity="0" />
            <ContentPresenter x:Name="Presenter"
                              Padding="{TemplateBinding Padding}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="StateLayer.Opacity" Value="0.08" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="StateLayer.Opacity" Value="0.14" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Presenter.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Checkable version: used by ToggleButton (AUTO ORBIT, valves) and RadioButton (rail, mode). -->
  <ControlTemplate x:Key="ConsoleCheckableTemplate" TargetType="ToggleButton">
    <Grid x:Name="Root"
          Background="{TemplateBinding Background}"
          BorderBrush="{TemplateBinding BorderBrush}"
          BorderThickness="{TemplateBinding BorderThickness}"
          CornerRadius="{TemplateBinding CornerRadius}">
      <Border x:Name="StateLayer"
              Background="{StaticResource CyanBrush}"
              CornerRadius="{TemplateBinding CornerRadius}"
              Opacity="0" />
      <ContentPresenter x:Name="Presenter"
                        Padding="{TemplateBinding Padding}"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        Foreground="{TemplateBinding Foreground}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal" />
          <VisualState x:Name="PointerOver">
            <VisualState.Setters>
              <Setter Target="StateLayer.Opacity" Value="0.08" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Pressed">
            <VisualState.Setters>
              <Setter Target="StateLayer.Opacity" Value="0.14" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Disabled">
            <VisualState.Setters>
              <Setter Target="Presenter.Opacity" Value="0.4" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Checked">
            <VisualState.Setters>
              <Setter Target="Root.Background" Value="{StaticResource AccentFillBrush}" />
              <Setter Target="Root.BorderBrush" Value="{StaticResource AccentBrush}" />
              <Setter Target="Presenter.Foreground" Value="{StaticResource AccentBrush}" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="CheckedPointerOver">
            <VisualState.Setters>
              <Setter Target="Root.Background" Value="{StaticResource AccentFillBrush}" />
              <Setter Target="Root.BorderBrush" Value="{StaticResource AccentBrush}" />
              <Setter Target="Presenter.Foreground" Value="{StaticResource AccentBrush}" />
              <Setter Target="StateLayer.Opacity" Value="0.08" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="CheckedPressed">
            <VisualState.Setters>
              <Setter Target="Root.Background" Value="{StaticResource AccentFillBrush}" />
              <Setter Target="Root.BorderBrush" Value="{StaticResource AccentBrush}" />
              <Setter Target="Presenter.Foreground" Value="{StaticResource AccentBrush}" />
              <Setter Target="StateLayer.Opacity" Value="0.14" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="CheckedDisabled">
            <VisualState.Setters>
              <Setter Target="Presenter.Opacity" Value="0.4" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Indeterminate" />
          <VisualState x:Name="IndeterminatePointerOver" />
          <VisualState x:Name="IndeterminatePressed" />
          <VisualState x:Name="IndeterminateDisabled" />
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
    </Grid>
  </ControlTemplate>

  <!-- Same shape, cyan when checked: an open valve is "on", not "selected". -->
  <ControlTemplate x:Key="CyanCheckableTemplate" TargetType="ToggleButton">
    <Grid x:Name="Root"
          Background="{TemplateBinding Background}"
          BorderBrush="{TemplateBinding BorderBrush}"
          BorderThickness="{TemplateBinding BorderThickness}"
          CornerRadius="{TemplateBinding CornerRadius}">
      <Border x:Name="StateLayer"
              Background="{StaticResource CyanBrush}"
              CornerRadius="{TemplateBinding CornerRadius}"
              Opacity="0" />
      <ContentPresenter x:Name="Presenter"
                        Padding="{TemplateBinding Padding}"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        Foreground="{TemplateBinding Foreground}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal" />
          <VisualState x:Name="PointerOver">
            <VisualState.Setters>
              <Setter Target="StateLayer.Opacity" Value="0.08" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Pressed">
            <VisualState.Setters>
              <Setter Target="StateLayer.Opacity" Value="0.14" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Disabled">
            <VisualState.Setters>
              <Setter Target="Presenter.Opacity" Value="0.4" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Checked">
            <VisualState.Setters>
              <Setter Target="Root.Background" Value="{StaticResource CyanFillBrush}" />
              <Setter Target="Root.BorderBrush" Value="{StaticResource BorderBrushStrong}" />
              <Setter Target="Presenter.Foreground" Value="{StaticResource TextPrimaryBrush}" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="CheckedPointerOver">
            <VisualState.Setters>
              <Setter Target="Root.Background" Value="{StaticResource CyanFillBrush}" />
              <Setter Target="Root.BorderBrush" Value="{StaticResource BorderBrushStrong}" />
              <Setter Target="Presenter.Foreground" Value="{StaticResource TextPrimaryBrush}" />
              <Setter Target="StateLayer.Opacity" Value="0.08" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="CheckedPressed">
            <VisualState.Setters>
              <Setter Target="Root.Background" Value="{StaticResource CyanFillBrush}" />
              <Setter Target="Root.BorderBrush" Value="{StaticResource BorderBrushStrong}" />
              <Setter Target="Presenter.Foreground" Value="{StaticResource TextPrimaryBrush}" />
              <Setter Target="StateLayer.Opacity" Value="0.14" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="CheckedDisabled">
            <VisualState.Setters>
              <Setter Target="Presenter.Opacity" Value="0.4" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Indeterminate" />
          <VisualState x:Name="IndeterminatePointerOver" />
          <VisualState x:Name="IndeterminatePressed" />
          <VisualState x:Name="IndeterminateDisabled" />
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
    </Grid>
  </ControlTemplate>

  <Style x:Key="ConsoleToggleButton" TargetType="ToggleButton" BasedOn="{StaticResource ConsoleButtonBase}">
    <Setter Property="Template" Value="{StaticResource ConsoleCheckableTemplate}" />
  </Style>

  <!--
    Text inside a control (a button's label) must take the control's Foreground. Simple's implicit
    TextBlock style sets Foreground locally, which beats inheritance, so such text kept Simple's ink
    (dark theme: #DFF5FF) instead of the accent or alert colour. An explicit style replaces the
    implicit one, and with no Foreground setter the label inherits again.
  -->
  <Style x:Key="ControlLabel" TargetType="TextBlock" />

  <!-- Valve labels: no Foreground setter, so the toggle's checked/unchecked ink still applies.
       The state line is one size smaller instead of faded (text opacity breaks contrast). -->
  <Style x:Key="ValveNumber" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoMediumFont}" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style x:Key="ValveState" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="10" />
  </Style>

  <Style x:Key="ValveToggleButton" TargetType="ToggleButton" BasedOn="{StaticResource ConsoleButtonBase}">
    <Setter Property="Template" Value="{StaticResource CyanCheckableTemplate}" />
    <Setter Property="Height" Value="{StaticResource ControlHeight}" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
    <Setter Property="Foreground" Value="{StaticResource FaintBrush}" />
  </Style>

  <!-- RadioButton template: same look, RadioButton's own state names (CheckStates group). -->
  <Style x:Key="ConsoleRadioButton" TargetType="RadioButton" BasedOn="{StaticResource ConsoleButtonBase}">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid x:Name="Root"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
            <Border x:Name="StateLayer"
                    Background="{StaticResource CyanBrush}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Opacity="0" />
            <ContentPresenter x:Name="Presenter"
                              Padding="{TemplateBinding Padding}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="StateLayer.Opacity" Value="0.08" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="StateLayer.Opacity" Value="0.14" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Presenter.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="CheckStates">
                <VisualState x:Name="Checked">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{StaticResource AccentFillBrush}" />
                    <Setter Target="Root.BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter Target="Presenter.Foreground" Value="{StaticResource AccentBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Unchecked" />
                <VisualState x:Name="Indeterminate" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="RailRadioButton" TargetType="RadioButton" BasedOn="{StaticResource ConsoleRadioButton}">
    <Setter Property="Width" Value="52" />
    <Setter Property="Height" Value="{StaticResource ControlHeightLarge}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusRail}" />
    <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
    <Setter Property="GroupName" Value="Rail" />
  </Style>

  <Style x:Key="ModeRadioButton" TargetType="RadioButton" BasedOn="{StaticResource ConsoleRadioButton}">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Height" Value="{StaticResource ControlHeight}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
    <Setter Property="GroupName" Value="Mode" />
  </Style>

  <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource ConsoleButton}">
    <Setter Property="Width" Value="{StaticResource ControlHeight}" />
    <Setter Property="Height" Value="{StaticResource ControlHeight}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="{StaticResource OverlayBrush}" />
  </Style>

  <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource ConsoleButton}">
    <Setter Property="Height" Value="{StaticResource ControlHeight}" />
    <Setter Property="Background" Value="{StaticResource OverlayBrush}" />
  </Style>

  <Style x:Key="ToolbarToggleButton" TargetType="ToggleButton" BasedOn="{StaticResource ConsoleToggleButton}">
    <Setter Property="Height" Value="{StaticResource ControlHeight}" />
    <Setter Property="Background" Value="{StaticResource OverlayBrush}" />
  </Style>

  <!-- Floating unit tag in the 3D view: 24 px tall (the WCAG 2.2 minimum target). Brushes are set per state in code. -->
  <Style x:Key="TagButton" TargetType="Button" BasedOn="{StaticResource ConsoleButton}">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="7,0" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusTag}" />
    <Setter Property="FontSize" Value="10" />
  </Style>

  <Style x:Key="PathIconStyle" TargetType="Path">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="StrokeThickness" Value="1.6" />
    <Setter Property="StrokeStartLineCap" Value="Round" />
    <Setter Property="StrokeEndLineCap" Value="Round" />
    <Setter Property="StrokeLineJoin" Value="Round" />
  </Style>
</ResourceDictionary>
