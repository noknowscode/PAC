<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Console control styles. One template shape for every clickable thing: a matte filled surface
    with no outline, plus an ink state layer that reads +6% on hover and +10% on press. Checked
    raises the surface to white with orange text (the one indicator colour). Focus uses system
    focus visuals in the accent.
  -->

  <Style x:Key="CardStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource CardBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <Style x:Key="ConsoleButtonBase" TargetType="ButtonBase">
    <Setter Property="Background" Value="{ThemeResource FillBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
    <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource SansMediumFont}" />
    <Setter Property="FontSize" Value="{StaticResource TypeSizeBody}" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource AccentBrush}" />
    <Setter Property="FocusVisualPrimaryThickness" Value="2" />
    <Setter Property="FocusVisualSecondaryThickness" Value="0" />
    <Setter Property="FocusVisualMargin" Value="-3" />
  </Style>

  <Style x:Key="ConsoleButton" TargetType="Button" BasedOn="{StaticResource ConsoleButtonBase}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
            <Border x:Name="StateLayer"
                    Background="{ThemeResource TextPrimaryBrush}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Opacity="0" />
            <ContentPresenter x:Name="Presenter"
                              Padding="{TemplateBinding Padding}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="StateLayer.Opacity" Value="0.06" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="StateLayer.Opacity" Value="0.10" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Presenter.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Checkable version: used by ToggleButton (auto orbit, theme) and RadioButton (mode). -->
  <ControlTemplate x:Key="ConsoleCheckableTemplate" TargetType="ToggleButton">
    <Grid x:Name="Root"
          Background="{TemplateBinding Background}"
          BorderBrush="{TemplateBinding BorderBrush}"
          BorderThickness="{TemplateBinding BorderThickness}"
          CornerRadius="{TemplateBinding CornerRadius}">
      <Border x:Name="StateLayer"
              Background="{ThemeResource TextPrimaryBrush}"
              CornerRadius="{TemplateBinding CornerRadius}"
              Opacity="0" />
      <ContentPresenter x:Name="Presenter"
                        Padding="{TemplateBinding Padding}"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        Foreground="{TemplateBinding Foreground}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal" />
          <VisualState x:Name="PointerOver">
            <VisualState.Setters>
              <Setter Target="StateLayer.Opacity" Value="0.06" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Pressed">
            <VisualState.Setters>
              <Setter Target="StateLayer.Opacity" Value="0.10" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Disabled">
            <VisualState.Setters>
              <Setter Target="Presenter.Opacity" Value="0.4" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Checked">
            <VisualState.Setters>
              <Setter Target="Root.Background" Value="{ThemeResource CardBrush}" />
              <Setter Target="Presenter.Foreground" Value="{ThemeResource AccentBrush}" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="CheckedPointerOver">
            <VisualState.Setters>
              <Setter Target="Root.Background" Value="{ThemeResource CardBrush}" />
              <Setter Target="Presenter.Foreground" Value="{ThemeResource AccentBrush}" />
              <Setter Target="StateLayer.Opacity" Value="0.06" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="CheckedPressed">
            <VisualState.Setters>
              <Setter Target="Root.Background" Value="{ThemeResource CardBrush}" />
              <Setter Target="Presenter.Foreground" Value="{ThemeResource AccentBrush}" />
              <Setter Target="StateLayer.Opacity" Value="0.10" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="CheckedDisabled">
            <VisualState.Setters>
              <Setter Target="Presenter.Opacity" Value="0.4" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Indeterminate" />
          <VisualState x:Name="IndeterminatePointerOver" />
          <VisualState x:Name="IndeterminatePressed" />
          <VisualState x:Name="IndeterminateDisabled" />
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
    </Grid>
  </ControlTemplate>

  <!-- Same shape, filled when checked: an open valve is "on", not "selected", so it never turns orange. -->
  <ControlTemplate x:Key="FillCheckableTemplate" TargetType="ToggleButton">
    <Grid x:Name="Root"
          Background="{TemplateBinding Background}"
          BorderBrush="{TemplateBinding BorderBrush}"
          BorderThickness="{TemplateBinding BorderThickness}"
          CornerRadius="{TemplateBinding CornerRadius}">
      <Border x:Name="StateLayer"
              Background="{ThemeResource TextPrimaryBrush}"
              CornerRadius="{TemplateBinding CornerRadius}"
              Opacity="0" />
      <ContentPresenter x:Name="Presenter"
                        Padding="{TemplateBinding Padding}"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        Foreground="{TemplateBinding Foreground}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal" />
          <VisualState x:Name="PointerOver">
            <VisualState.Setters>
              <Setter Target="StateLayer.Opacity" Value="0.06" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Pressed">
            <VisualState.Setters>
              <Setter Target="StateLayer.Opacity" Value="0.10" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Disabled">
            <VisualState.Setters>
              <Setter Target="Presenter.Opacity" Value="0.4" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Checked">
            <VisualState.Setters>
              <Setter Target="Root.Background" Value="{ThemeResource FillStrongBrush}" />
              <Setter Target="Root.BorderBrush" Value="Transparent" />
              <Setter Target="Presenter.Foreground" Value="{ThemeResource TextPrimaryBrush}" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="CheckedPointerOver">
            <VisualState.Setters>
              <Setter Target="Root.Background" Value="{ThemeResource FillStrongBrush}" />
              <Setter Target="Root.BorderBrush" Value="Transparent" />
              <Setter Target="Presenter.Foreground" Value="{ThemeResource TextPrimaryBrush}" />
              <Setter Target="StateLayer.Opacity" Value="0.06" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="CheckedPressed">
            <VisualState.Setters>
              <Setter Target="Root.Background" Value="{ThemeResource FillStrongBrush}" />
              <Setter Target="Root.BorderBrush" Value="Transparent" />
              <Setter Target="Presenter.Foreground" Value="{ThemeResource TextPrimaryBrush}" />
              <Setter Target="StateLayer.Opacity" Value="0.10" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="CheckedDisabled">
            <VisualState.Setters>
              <Setter Target="Presenter.Opacity" Value="0.4" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Indeterminate" />
          <VisualState x:Name="IndeterminatePointerOver" />
          <VisualState x:Name="IndeterminatePressed" />
          <VisualState x:Name="IndeterminateDisabled" />
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
    </Grid>
  </ControlTemplate>

  <Style x:Key="ConsoleToggleButton" TargetType="ToggleButton" BasedOn="{StaticResource ConsoleButtonBase}">
    <Setter Property="Template" Value="{StaticResource ConsoleCheckableTemplate}" />
  </Style>

  <!--
    Text inside a control (a button's label) must take the control's Foreground. Simple's implicit
    TextBlock style sets Foreground locally, which beats inheritance, so such text kept Simple's ink
    (dark theme: #DFF5FF) instead of the accent or alert colour. An explicit style replaces the
    implicit one, and with no Foreground setter the label inherits again.
  -->
  <Style x:Key="ControlLabel" TargetType="TextBlock" />

  <!-- Valve labels: no Foreground setter, so the toggle's checked/unchecked ink still applies.
       The state line is one size smaller instead of faded (text opacity breaks contrast). -->
  <Style x:Key="ValveNumber" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource SansMediumFont}" />
    <Setter Property="FontSize" Value="{StaticResource TypeSizeMicro}" />
  </Style>
  <Style x:Key="ValveState" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
    <Setter Property="FontSize" Value="{StaticResource TypeSizeMicro}" />
  </Style>

  <Style x:Key="ValveToggleButton" TargetType="ToggleButton" BasedOn="{StaticResource ConsoleButtonBase}">
    <Setter Property="Template" Value="{StaticResource FillCheckableTemplate}" />
    <Setter Property="Height" Value="{StaticResource ControlHeight}" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{ThemeResource BorderBrushDefault}" />
    <Setter Property="Foreground" Value="{ThemeResource MutedBrush}" />
  </Style>

  <!-- RadioButton template: same look, RadioButton's own state names (CheckStates group). -->
  <Style x:Key="ConsoleRadioButton" TargetType="RadioButton" BasedOn="{StaticResource ConsoleButtonBase}">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid x:Name="Root"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
            <Border x:Name="StateLayer"
                    Background="{ThemeResource TextPrimaryBrush}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Opacity="0" />
            <ContentPresenter x:Name="Presenter"
                              Padding="{TemplateBinding Padding}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="StateLayer.Opacity" Value="0.06" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="StateLayer.Opacity" Value="0.10" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Presenter.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="CheckStates">
                <VisualState x:Name="Checked">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource CardBrush}" />
                    <Setter Target="Presenter.Foreground" Value="{ThemeResource AccentBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Unchecked" />
                <VisualState x:Name="Indeterminate" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ModeRadioButton" TargetType="RadioButton" BasedOn="{StaticResource ConsoleRadioButton}">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Height" Value="{StaticResource ControlHeight}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{ThemeResource MutedBrush}" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="GroupName" Value="Mode" />
  </Style>

  <!--
    Segmented choices that set a view (systems, standard views, trend range): the chosen segment fills
    with the soft fill and ink text, because it is a filter, not the selection colour.
  -->
  <Style x:Key="SegmentRadioButton" TargetType="RadioButton" BasedOn="{StaticResource ConsoleButtonBase}">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{ThemeResource InkSoftBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid x:Name="Root"
                Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}">
            <Border x:Name="StateLayer"
                    Background="{ThemeResource TextPrimaryBrush}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Opacity="0" />
            <ContentPresenter x:Name="Presenter"
                              Padding="{TemplateBinding Padding}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              FontFamily="{TemplateBinding FontFamily}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="StateLayer.Opacity" Value="0.05" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="StateLayer.Opacity" Value="0.09" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Presenter.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="CheckStates">
                <VisualState x:Name="Checked">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource FillBrush}" />
                    <Setter Target="Presenter.Foreground" Value="{ThemeResource TextPrimaryBrush}" />
                    <Setter Target="Presenter.FontFamily" Value="{StaticResource SansMediumFont}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Unchecked" />
                <VisualState x:Name="Indeterminate" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ViewRadioButton" TargetType="RadioButton" BasedOn="{StaticResource SegmentRadioButton}">
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="10,0" />
  </Style>

  <!--
    A view thumbnail beside the plant: the plant from one standard camera over its name, straight on the
    panel ground. The view the camera rests in takes the accent outline and ink label; the others a frame.
  -->
  <Style x:Key="ThumbRadioButton" TargetType="RadioButton" BasedOn="{StaticResource ConsoleButtonBase}">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{ThemeResource ThumbFrameBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource MutedBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <!-- xaml-lint: allow card - a selectable tile's frame (hairline, accent when chosen), not a content surface. -->
          <Border x:Name="Frame"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <Grid>
              <Border x:Name="StateLayer" Background="{ThemeResource TextPrimaryBrush}" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" />
              <ContentPresenter x:Name="Presenter"
                                Padding="{TemplateBinding Padding}"
                                Content="{TemplateBinding Content}"
                                Foreground="{TemplateBinding Foreground}"
                                FontFamily="{TemplateBinding FontFamily}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Grid>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="StateLayer.Opacity" Value="0.04" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="StateLayer.Opacity" Value="0.08" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled" />
              </VisualStateGroup>
              <VisualStateGroup x:Name="CheckStates">
                <VisualState x:Name="Checked">
                  <VisualState.Setters>
                    <Setter Target="Frame.BorderBrush" Value="{ThemeResource AccentBrush}" />
                    <Setter Target="Presenter.Foreground" Value="{ThemeResource TextPrimaryBrush}" />
                    <Setter Target="Presenter.FontFamily" Value="{StaticResource SansMediumFont}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Unchecked" />
                <VisualState x:Name="Indeterminate" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Inspector tabs: text with a 2 px slate-teal underline on the open tab. -->
  <Style x:Key="TabRadioButton" TargetType="RadioButton" BasedOn="{StaticResource ConsoleButtonBase}">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{ThemeResource MutedBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid x:Name="Root" Background="Transparent">
            <ContentPresenter x:Name="Presenter"
                              Padding="{TemplateBinding Padding}"
                              Content="{TemplateBinding Content}"
                              Foreground="{TemplateBinding Foreground}"
                              FontFamily="{TemplateBinding FontFamily}"
                              VerticalContentAlignment="Center" />
            <Border x:Name="Indicator" Height="2" VerticalAlignment="Bottom" Background="{ThemeResource AccentBrush}" Opacity="0" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Presenter.Foreground" Value="{ThemeResource TextPrimaryBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Presenter.Foreground" Value="{ThemeResource TextPrimaryBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Presenter.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="CheckStates">
                <VisualState x:Name="Checked">
                  <VisualState.Setters>
                    <Setter Target="Indicator.Opacity" Value="1" />
                    <Setter Target="Presenter.Foreground" Value="{ThemeResource TextPrimaryBrush}" />
                    <Setter Target="Presenter.FontFamily" Value="{StaticResource SansMediumFont}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Unchecked" />
                <VisualState x:Name="Indeterminate" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A neutral switch (theme): checked fills, never orange, because it is a setting, not a selection. -->
  <Style x:Key="QuietToggleButton" TargetType="ToggleButton" BasedOn="{StaticResource ConsoleButtonBase}">
    <Setter Property="Template" Value="{StaticResource FillCheckableTemplate}" />
    <Setter Property="Height" Value="{StaticResource ControlHeight}" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{ThemeResource InkSoftBrush}" />
  </Style>

  <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource ConsoleButton}">
    <Setter Property="Width" Value="{StaticResource ControlHeight}" />
    <Setter Property="Height" Value="{StaticResource ControlHeight}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{ThemeResource InkSoftBrush}" />
  </Style>

  <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource ConsoleButton}">
    <Setter Property="Height" Value="{StaticResource ControlHeight}" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{ThemeResource InkSoftBrush}" />
  </Style>

  <Style x:Key="ToolbarToggleButton" TargetType="ToggleButton" BasedOn="{StaticResource ConsoleToggleButton}">
    <Setter Property="Height" Value="{StaticResource ControlHeight}" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{ThemeResource InkSoftBrush}" />
  </Style>

  <!-- Figure callout in the plant view: a quiet label plate at the end of a hairline leader, 24 px tall
       (the WCAG 2.2 minimum target). Brushes are set per state in code; the selected plate turns orange. -->
  <Style x:Key="TagButton" TargetType="Button" BasedOn="{StaticResource ConsoleButton}">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusTag}" />
    <Setter Property="FontSize" Value="{StaticResource TypeSizeMicro}" />
  </Style>

  <Style x:Key="PathIconStyle" TargetType="Path">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="StrokeThickness" Value="1.6" />
    <Setter Property="StrokeStartLineCap" Value="Round" />
    <Setter Property="StrokeEndLineCap" Value="Round" />
    <Setter Property="StrokeLineJoin" Value="Round" />
  </Style>
</ResourceDictionary>
