<!--
  PAC Control Console: the type scale. The Simple theme reads it through App.xaml (SimpleToolkitTheme.FontOverrideSource)
  on top of DefaultFontFamily (IBM Plex Sans, set on the theme), so every semantic text style (DisplayLarge ... CaptionSmall),
  the theme's own controls (the equipment picker, the setpoint fields, the shift-note box, menus) and the console's text
  and control styles take the design's sizes and weights from here.

  The design's ramp is closed (.impeccable.md, Direction 2): 12 / 13 / 16 / 22 / 28, weights 400 / 500 / 600, sentence
  case. IBM Plex Sans ships as static faces with weight-suffixed family names; the font manifest beside the regular face
  (Assets/Fonts/IBMPlexSans-Regular.ttf.manifest) maps FontWeight to the Medium and SemiBold files, so one family plus a
  weight picks the right face. Its digits are tabular by default, so live values hold still.

    Style            Size  Weight    Used for
    DisplayLarge     28    SemiBold
    DisplayMedium    28    SemiBold
    DisplaySmall     22    SemiBold
    HeadlineLarge    28    SemiBold
    HeadlineMedium   28    SemiBold  net output, the inspector's equipment name (TypeDisplay)
    HeadlineSmall    22    Regular   readings and trend values (TypeValue)
    TitleLarge       22    SemiBold
    TitleMedium      16    SemiBold  band titles, the station (TypeTitle)
    TitleSmall       13    SemiBold
    BodyLarge        16    Regular
    BodyMedium       13    Regular   body text (TypeBody), segment and tab labels
    BodySmall        12    Regular   captions, labels, units (TypeMicro), chips
    LabelLarge       13    Medium    the theme's buttons
    LabelMedium      13    Medium    section labels (TypeSection), console buttons
    LabelSmall       12    Medium    valve numbers, plant tags
    LabelExtraSmall  12    Medium
    CaptionLarge     13    Regular
    CaptionMedium    12    Regular
    CaptionSmall     12    Regular
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <x:Double x:Key="DisplayLargeFontSize">28</x:Double>
  <x:String x:Key="DisplayLargeFontWeight">SemiBold</x:String>
  <x:Double x:Key="DisplayMediumFontSize">28</x:Double>
  <x:String x:Key="DisplayMediumFontWeight">SemiBold</x:String>
  <x:Double x:Key="DisplaySmallFontSize">22</x:Double>
  <x:String x:Key="DisplaySmallFontWeight">SemiBold</x:String>

  <x:Double x:Key="HeadlineLargeFontSize">28</x:Double>
  <x:String x:Key="HeadlineLargeFontWeight">SemiBold</x:String>
  <x:Double x:Key="HeadlineMediumFontSize">28</x:Double>
  <x:String x:Key="HeadlineMediumFontWeight">SemiBold</x:String>
  <x:Double x:Key="HeadlineSmallFontSize">22</x:Double>
  <x:String x:Key="HeadlineSmallFontWeight">Normal</x:String>

  <x:Double x:Key="TitleLargeFontSize">22</x:Double>
  <x:String x:Key="TitleLargeFontWeight">SemiBold</x:String>
  <x:Double x:Key="TitleMediumFontSize">16</x:Double>
  <x:String x:Key="TitleMediumFontWeight">SemiBold</x:String>
  <x:Double x:Key="TitleSmallFontSize">13</x:Double>
  <x:String x:Key="TitleSmallFontWeight">SemiBold</x:String>

  <x:Double x:Key="BodyLargeFontSize">16</x:Double>
  <x:String x:Key="BodyLargeFontWeight">Normal</x:String>
  <x:Double x:Key="BodyMediumFontSize">13</x:Double>
  <x:String x:Key="BodyMediumFontWeight">Normal</x:String>
  <x:Double x:Key="BodySmallFontSize">12</x:Double>
  <x:String x:Key="BodySmallFontWeight">Normal</x:String>

  <x:Double x:Key="LabelLargeFontSize">13</x:Double>
  <x:String x:Key="LabelLargeFontWeight">Medium</x:String>
  <x:Double x:Key="LabelMediumFontSize">13</x:Double>
  <x:String x:Key="LabelMediumFontWeight">Medium</x:String>
  <x:Double x:Key="LabelSmallFontSize">12</x:Double>
  <x:String x:Key="LabelSmallFontWeight">Medium</x:String>
  <x:Double x:Key="LabelExtraSmallFontSize">12</x:Double>
  <x:String x:Key="LabelExtraSmallFontWeight">Medium</x:String>

  <x:Double x:Key="CaptionLargeFontSize">13</x:Double>
  <x:String x:Key="CaptionLargeFontWeight">Normal</x:String>
  <x:Double x:Key="CaptionMediumFontSize">12</x:Double>
  <x:String x:Key="CaptionMediumFontWeight">Normal</x:String>
  <x:Double x:Key="CaptionSmallFontSize">12</x:Double>
  <x:String x:Key="CaptionSmallFontWeight">Normal</x:String>

</ResourceDictionary>
