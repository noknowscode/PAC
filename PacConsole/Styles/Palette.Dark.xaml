<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Graphite: the dark theme. Not merged as resources: ConsoleTheme copies each colour into the brush
    (or Color) of the same key, so every StaticResource, converter result and canvas palette follows a
    switch. Neutral greys with no blue cast; the same single orange. Contrast on the ground (#16181B):
    ink 14.9, soft ink 10.2, muted 7.4, accent 8.1, alert text 6.6.
  -->
  <!-- xaml-lint: allow tokentheme - this file is the dark half of the in-place repaint (see Tokens.xaml). -->

  <Color x:Key="GroundBrush">#16181B</Color>
