<!--
  PAC Control Console: the palette. The one file that holds the console's role colours. The Simple theme reads it
  through App.xaml (SimpleToolkitTheme.Colors > ThemeColors.OverrideSource) and generates every role brush from it
  (PrimaryBrush, OnSurfaceVariantBrush, OutlineVariantBrush and their Hover, Pressed, Low... variants), so Uno Platform
  Studio's Themes tab, which edits this file, recolours the console. The design gives a full Light and Graphite table
  (docs/SPEC-THEME.md, .impeccable.md Direction 2), so every role is set here and no generated colour reaches the screen.

  Where the design's tokens went:
    ground (page, plant panel, footer)  -> Background          card (header, inspector, bands) -> Surface
    ink                                 -> OnSurface, OnBackground, SurfaceInverse (tooltips), SecondaryContainer's On
    soft ink (toolbar and segment labels, the inspector's description, the cursor) -> Secondary
    muted (captions, labels, units)     -> OnSurfaceVariant    faint (placeholders, idle marks, the valve ring) -> Outline
    hairline (rules, frames)            -> OutlineVariant      control fill (buttons, tracks) -> SecondaryContainer, SurfaceVariant
    strong fill (pressed)               -> TertiaryContainer
    slate-teal accent (selected, compared, plotted, focus, the primary action) -> Primary; its soft fill -> PrimaryContainer
    the PAC mark's orange               -> Tertiary
    errors (telemetry stopped, a refused command, a failed save) -> Error, ErrorContainer
  Alarms, process states, the select-before-operate highlight and the plant's own colours are not roles: they keep
  their meaning whatever the palette, so they live in App.xaml's Light and Default dictionaries.

  Contrast (WCAG), text on the grounds it is set on. Light: OnSurface 14.9:1 on Surface, OnSurfaceVariant 5.4:1 on
  Background and 5.0:1 on SurfaceVariant, Secondary 8.9:1, Primary 6.6:1 on Background, OnPrimary 7.2:1 on Primary,
  Error 6.2:1 on Surface and 5.3:1 on ErrorContainer. Graphite: OnSurface 9.9:1 on Surface, OnSurfaceVariant 4.9:1 on
  Surface and 7.3:1 on Background, Primary 5.2:1 on Surface, OnPrimary 7.7:1 on Primary, Error 4.9:1 on Surface.

  "Default" is the Graphite (Dark) dictionary, the WinUI convention.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <!-- Light: the instrument by day -->
    <ResourceDictionary x:Key="Light">
      <Color x:Key="PrimaryColor">#FF2F5D73</Color>
      <Color x:Key="OnPrimaryColor">#FFFFFFFF</Color>
      <Color x:Key="PrimaryContainerColor">#FFE3EEF3</Color>
      <Color x:Key="OnPrimaryContainerColor">#FF173543</Color>
      <Color x:Key="PrimaryInverseColor">#FF7FB3C8</Color>
      <Color x:Key="PrimaryVariantDarkColor">#FF254A5C</Color>
      <Color x:Key="PrimaryVariantLightColor">#FF638696</Color>

      <Color x:Key="SecondaryColor">#FF3E4B5A</Color>
      <Color x:Key="OnSecondaryColor">#FFFFFFFF</Color>
      <Color x:Key="SecondaryContainerColor">#FFE9ECEF</Color>
      <Color x:Key="OnSecondaryContainerColor">#FF1E2833</Color>
      <Color x:Key="SecondaryVariantDarkColor">#FF1E2833</Color>
      <Color x:Key="SecondaryVariantLightColor">#FF5A6573</Color>

      <Color x:Key="TertiaryColor">#FFC2410C</Color>
      <Color x:Key="OnTertiaryColor">#FFFFFFFF</Color>
      <Color x:Key="TertiaryContainerColor">#FFD5DAE0</Color>
      <Color x:Key="OnTertiaryContainerColor">#FF1E2833</Color>

      <Color x:Key="ErrorColor">#FFAE3A0A</Color>
      <Color x:Key="OnErrorColor">#FFFFFFFF</Color>
      <Color x:Key="ErrorContainerColor">#FFFCEAD7</Color>
      <Color x:Key="OnErrorContainerColor">#FF1E2833</Color>

      <Color x:Key="BackgroundColor">#FFF4F5F6</Color>
      <Color x:Key="OnBackgroundColor">#FF1E2833</Color>

      <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
      <Color x:Key="OnSurfaceColor">#FF1E2833</Color>
      <Color x:Key="SurfaceVariantColor">#FFE9ECEF</Color>
      <Color x:Key="OnSurfaceVariantColor">#FF5A6573</Color>
      <Color x:Key="SurfaceInverseColor">#FF1E2833</Color>
      <Color x:Key="OnSurfaceInverseColor">#FFF4F5F6</Color>
      <Color x:Key="SurfaceTintColor">#FF2F5D73</Color>

      <Color x:Key="OutlineColor">#FF8A939E</Color>
      <Color x:Key="OutlineVariantColor">#FFD9DDE2</Color>
      <Color x:Key="ShadowColor">#FF1E2833</Color>
    </ResourceDictionary>

    <!-- Graphite: neutral greys with no blue cast, the same slate-teal lifted for a dark ground -->
    <ResourceDictionary x:Key="Default">
      <Color x:Key="PrimaryColor">#FF7FB3C8</Color>
      <Color x:Key="OnPrimaryColor">#FF0E1A20</Color>
      <Color x:Key="PrimaryContainerColor">#FF1A272D</Color>
      <Color x:Key="OnPrimaryContainerColor">#FFCFE3EC</Color>
      <Color x:Key="PrimaryInverseColor">#FF2F5D73</Color>
      <Color x:Key="PrimaryVariantDarkColor">#FF6B9FB4</Color>
      <Color x:Key="PrimaryVariantLightColor">#FFA3CADA</Color>

      <Color x:Key="SecondaryColor">#FFC4C9CF</Color>
      <Color x:Key="OnSecondaryColor">#FF16181B</Color>
      <Color x:Key="SecondaryContainerColor">#FF24282D</Color>
      <Color x:Key="OnSecondaryContainerColor">#FFE8EAEC</Color>
      <Color x:Key="SecondaryVariantDarkColor">#FFA0A7AF</Color>
      <Color x:Key="SecondaryVariantLightColor">#FFE8EAEC</Color>

      <Color x:Key="TertiaryColor">#FFF0793A</Color>
      <Color x:Key="OnTertiaryColor">#FF16181B</Color>
      <Color x:Key="TertiaryContainerColor">#FF353A40</Color>
      <Color x:Key="OnTertiaryContainerColor">#FFE8EAEC</Color>

      <Color x:Key="ErrorColor">#FFF38B55</Color>
      <Color x:Key="OnErrorColor">#FF16181B</Color>
      <Color x:Key="ErrorContainerColor">#FF3A2617</Color>
      <Color x:Key="OnErrorContainerColor">#FFE8EAEC</Color>

      <Color x:Key="BackgroundColor">#FF16181B</Color>
      <Color x:Key="OnBackgroundColor">#FFE8EAEC</Color>

      <Color x:Key="SurfaceColor">#FF33373D</Color>
      <Color x:Key="OnSurfaceColor">#FFE8EAEC</Color>
      <Color x:Key="SurfaceVariantColor">#FF24282D</Color>
      <Color x:Key="OnSurfaceVariantColor">#FFA0A7AF</Color>
      <Color x:Key="SurfaceInverseColor">#FFE8EAEC</Color>
      <Color x:Key="OnSurfaceInverseColor">#FF16181B</Color>
      <Color x:Key="SurfaceTintColor">#FF7FB3C8</Color>

      <Color x:Key="OutlineColor">#FF6E767F</Color>
      <Color x:Key="OutlineVariantColor">#FF2E3237</Color>
      <Color x:Key="ShadowColor">#FF000000</Color>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
