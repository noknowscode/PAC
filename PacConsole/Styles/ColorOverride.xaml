<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Simple's colour roles, mapped onto the console palette (Palette.xaml) once per theme. Colours, not
    brushes, so Simple derives the hover, pressed and disabled variants itself. Stock controls (NumberBox,
    ComboBox, TextBox, tooltips) take their look from these roles.
  -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <!-- Accent: the slate-teal selection colour (AccentBrush) -->
      <Color x:Key="PrimaryColor">#2F5D73</Color>
      <Color x:Key="OnPrimaryColor">#FFFFFF</Color>
      <Color x:Key="PrimaryContainerColor">#E3EEF3</Color>
      <Color x:Key="OnPrimaryContainerColor">#173543</Color>

      <!-- Soft ink: secondary controls -->
      <Color x:Key="SecondaryColor">#3E4B5A</Color>
      <Color x:Key="OnSecondaryColor">#FFFFFF</Color>
      <Color x:Key="SecondaryContainerColor">#E9ECEF</Color>
      <Color x:Key="OnSecondaryContainerColor">#1E2833</Color>

      <!-- Ground and card surfaces -->
      <Color x:Key="BackgroundColor">#F4F5F6</Color>
      <Color x:Key="OnBackgroundColor">#1E2833</Color>
      <Color x:Key="SurfaceColor">#FFFFFF</Color>
      <Color x:Key="OnSurfaceColor">#1E2833</Color>
      <Color x:Key="SurfaceVariantColor">#E9ECEF</Color>
      <Color x:Key="OnSurfaceVariantColor">#5A6573</Color>

      <!-- Control edge (3:1 on the ground) and hairline -->
      <Color x:Key="OutlineColor">#8A939E</Color>
      <Color x:Key="OutlineVariantColor">#D9DDE2</Color>

      <!-- Alert: burnt orange (AlertTextBrush) -->
      <Color x:Key="ErrorColor">#AE3A0A</Color>
      <Color x:Key="OnErrorColor">#FFFFFF</Color>
    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <Color x:Key="PrimaryColor">#7FB3C8</Color>
      <Color x:Key="OnPrimaryColor">#0E1A20</Color>
      <Color x:Key="PrimaryContainerColor">#1A272D</Color>
      <Color x:Key="OnPrimaryContainerColor">#CFE3EC</Color>

      <Color x:Key="SecondaryColor">#C4C9CF</Color>
      <Color x:Key="OnSecondaryColor">#16181B</Color>
      <Color x:Key="SecondaryContainerColor">#24282D</Color>
      <Color x:Key="OnSecondaryContainerColor">#E8EAEC</Color>

      <Color x:Key="BackgroundColor">#16181B</Color>
      <Color x:Key="OnBackgroundColor">#E8EAEC</Color>
      <Color x:Key="SurfaceColor">#33373D</Color>
      <Color x:Key="OnSurfaceColor">#E8EAEC</Color>
      <Color x:Key="SurfaceVariantColor">#24282D</Color>
      <Color x:Key="OnSurfaceVariantColor">#A0A7AF</Color>

      <Color x:Key="OutlineColor">#6E767F</Color>
      <Color x:Key="OutlineVariantColor">#2E3237</Color>

      <Color x:Key="ErrorColor">#F38B55</Color>
      <Color x:Key="OnErrorColor">#16181B</Color>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
