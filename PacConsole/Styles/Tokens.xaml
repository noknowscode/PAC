<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Console tokens: a quiet instrument (see .impeccable.md, Direction 2). Light is the base theme;
    Palette.Dark.xaml holds the graphite values, copied over these by ConsoleTheme on a switch.
    Counts are closed: 4 text colours, 1 hairline, 2 fills, 1 accent, 1 alert, 5 type sizes.
    Contrast on the ground (#F4F5F6): ink 14.2, soft ink 8.6, muted 5.6, accent 4.9, alert 6.1.
  -->

  <!-- One family. IBM Plex Sans digits are tabular by default (all 600 units), so live values hold still.
       The TTF family names are weight-suffixed, so the fragments must match exactly. -->
  <FontFamily x:Key="SansFont">ms-appx:///Assets/Fonts/IBMPlexSans-Regular.ttf#IBM Plex Sans</FontFamily>
  <FontFamily x:Key="SansMediumFont">ms-appx:///Assets/Fonts/IBMPlexSans-Medium.ttf#IBM Plex Sans Medm</FontFamily>
  <FontFamily x:Key="SansStrongFont">ms-appx:///Assets/Fonts/IBMPlexSans-SemiBold.ttf#IBM Plex Sans SmBld</FontFamily>

  <!-- xaml-lint: allow tokentheme - ConsoleTheme repaints these brushes in place from Palette.Dark.xaml; ThemeDictionaries would hand converters a snapshot (uno-runtime-gotchas, Theming and color). -->
  <!-- Ground and surfaces: the page is the ground; white is reserved for things you touch or read closely. -->
  <SolidColorBrush x:Key="GroundBrush" Color="#F4F5F6" />
  <SolidColorBrush x:Key="PanelBrush" Color="#F4F5F6" />
  <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="OverlayBrush" Color="#EBF4F5F6" />

  <!-- Text: ink, soft ink, muted, faint (faint is for non-text marks and placeholders only) -->
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1E2833" />
  <SolidColorBrush x:Key="InkSoftBrush" Color="#3E4B5A" />
  <SolidColorBrush x:Key="MutedBrush" Color="#5A6573" />
  <SolidColorBrush x:Key="FaintBrush" Color="#8A939E" />

  <!-- Lines and fills. Controls are filled, not outlined; the border keys serve focus rings and the valve ring. -->
  <SolidColorBrush x:Key="HairlineBrush" Color="#D9DDE2" />
  <SolidColorBrush x:Key="BorderBrushDefault" Color="#8A939E" />
  <SolidColorBrush x:Key="BorderBrushStrong" Color="#3E4B5A" />
  <SolidColorBrush x:Key="FillBrush" Color="#E9ECEF" />
  <SolidColorBrush x:Key="FillStrongBrush" Color="#D5DAE0" />

  <!-- Accent: the one orange indicator. Selected and live, nothing else. -->
  <SolidColorBrush x:Key="AccentBrush" Color="#C2410C" />
  <SolidColorBrush x:Key="AccentFillBrush" Color="#1FC2410C" />
  <SolidColorBrush x:Key="AccentTintBrush" Color="#0DC2410C" />
  <SolidColorBrush x:Key="AccentBorderBrush" Color="#99C2410C" />
  <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />

  <!-- Alert: always paired with the word (alert, high) or a dashed stroke -->
  <SolidColorBrush x:Key="AlertBrush" Color="#C0261B" />
  <SolidColorBrush x:Key="AlertTextBrush" Color="#B42318" />
  <SolidColorBrush x:Key="AlertBorderBrush" Color="#B3C0261B" />
  <SolidColorBrush x:Key="AlertTintBrush" Color="#12C0261B" />

  <!-- Type ramp, closed: 12 / 13 / 16 / 22 / 56, weights 400 / 500 / 600, sentence case. -->
  <Style x:Key="TypeMicro" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="16" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
  </Style>
  <Style x:Key="TypeBody" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>
  <Style x:Key="TypeSection" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource SansMediumFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>
  <Style x:Key="TypeCode" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource SansMediumFont}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>
  <Style x:Key="TypeTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource SansStrongFont}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>
  <Style x:Key="TypeValue" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
    <Setter Property="FontSize" Value="22" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>
  <Style x:Key="TypeFigure" TargetType="TextBlock" BasedOn="{StaticResource TypeValue}" />
  <!-- The one display figure on the page (net output): 56 against 13 body, 4.3x. -->
  <Style x:Key="TypeHero" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
    <Setter Property="FontSize" Value="56" />
    <Setter Property="LineHeight" Value="60" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>

  <!--
    Plant drawings (hero, presets, unit preview): the Anatomy figure's solid look, drawn straight on
    the ground. Paper is the ground colour, so the figure's silhouette sits on the page with no frame.
    Shades step down from paper, tops step up; the selected unit is lit with a faint orange.
  -->
  <Color x:Key="SolidPaperColor">#F4F5F6</Color>
  <Color x:Key="SolidShade0Color">#C9D4DE</Color>
  <Color x:Key="SolidShade1Color">#D6DFE7</Color>
  <Color x:Key="SolidShade2Color">#E2E9EF</Color>
  <Color x:Key="SolidShade3Color">#ECF1F5</Color>
  <Color x:Key="SolidTopColor">#FFFFFF</Color>
  <Color x:Key="SolidLitFaceColor">#FCEBDF</Color>
  <Color x:Key="SolidLitShadeColor">#F6D9C6</Color>
  <Color x:Key="SolidLitTopColor">#FFF7F1</Color>
  <Color x:Key="SolidLineHiColor">#1E2833</Color>
  <Color x:Key="SolidLineMidColor">#5E6E80</Color>
  <Color x:Key="SolidLineLoColor">#9AA9B8</Color>
  <Color x:Key="SolidLineFaintColor">#C3CED8</Color>
  <!-- The inked silhouette every piece of equipment carries (the reference's navy, kept in slate). -->
  <Color x:Key="SolidSilhouetteColor">#2C3D50</Color>
  <Color x:Key="SolidLeaderColor">#8A939E</Color>
  <!-- Flat ground shadow: one opaque tone, so overlapping shadows never darken. -->
  <Color x:Key="SolidShadowColor">#D3DDE6</Color>
  <x:Double x:Key="SolidStrokeHairline">0.7</x:Double>
  <x:Double x:Key="SolidStrokeSilhouette">1.15</x:Double>
  <x:Double x:Key="SolidStrokeLit">1.3</x:Double>

  <!-- Radii: soft, one step per scale. Spacing follows a 4 px grid. -->
  <CornerRadius x:Key="RadiusTag">4</CornerRadius>
  <CornerRadius x:Key="RadiusControl">8</CornerRadius>
  <CornerRadius x:Key="RadiusRail">8</CornerRadius>
  <CornerRadius x:Key="RadiusCard">12</CornerRadius>
  <CornerRadius x:Key="RadiusPanel">12</CornerRadius>
  <x:Double x:Key="ControlHeight">32</x:Double>
  <x:Double x:Key="ControlHeightLarge">44</x:Double>
</ResourceDictionary>
