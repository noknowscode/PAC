<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <!--
      Five heads: Android, iOS, WinAppSDK, WebAssembly and desktop (Skia on Windows, macOS, Linux).
      Uno.Sdk skips the heads the build OS can't build (iOS on Linux, Windows off Windows).
    -->
    <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-windows10.0.19041;net10.0-browserwasm;net10.0-desktop</TargetFrameworks>
    <!--
      App-only override for single-head builds (CI, RID-specific publish): -p:PacTargetFrameworks=net10.0-desktop.
      A global -p:TargetFrameworks would also retarget PacConsole.Core and the test project.
    -->
    <TargetFrameworks Condition="'$(PacTargetFrameworks)' != ''">$(PacTargetFrameworks)</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <!-- Display name -->
    <ApplicationTitle>PacConsole</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>com.unoplatform.pacconsole</ApplicationId>
    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Package Publisher -->
    <ApplicationPublisher>PacConsole</ApplicationPublisher>
    <!-- Package Description -->
    <Description>PacConsole powered by Uno Platform.</Description>

    <!--
      UnoFeatures are used to quickly add and manage features enabled for your app.
      https://aka.platform.uno/singleproject-features
    -->
    <!-- An API Uno Platform does not implement fails the build instead of doing nothing at runtime. -->
    <WarningsAsErrors>$(WarningsAsErrors);Uno0001</WarningsAsErrors>
    <UnoFeatures>
      SimpleTheme;
      Hosting;
      Toolkit;
      Logging;
      MVUX;
      Navigation;
      SkiaRenderer;
    </UnoFeatures>
    <!--
      Uno.Sdk 7.0.0-dev.115: the Debug-only Hot Design and App MCP clients load Uno.UI.Lottie at startup and crash
      without it (FileNotFoundException in GlobalStaticResources). Debug builds carry Lottie until the dev tools stop
      needing it; Release never references it.
    -->
    <UnoFeatures Condition="'$(Configuration)' == 'Debug'">$(UnoFeatures);Lottie;</UnoFeatures>
  </PropertyGroup>

  <!--
    WinAppSDK: SKCanvasElement (the plant, its thumbnails and the trends) needs an x64 or ARM64 build, never AnyCPU.
    Uno 7's WinUI libraries need WinRT.Runtime 2.3.1; the default 19041 projection brings 2.2.0 (CS1705).
  -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <Platforms>x64;ARM64</Platforms>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <WindowsSdkPackageVersion>10.0.19041.87</WindowsSdkPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PacConsole.Core\PacConsole.Core.csproj" />
  </ItemGroup>

</Project>
