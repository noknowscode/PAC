<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <!-- v1 targets desktop only (Skia renderer on Windows, macOS, Linux). -->
    <TargetFrameworks>net10.0-desktop</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <!-- Display name -->
    <ApplicationTitle>PacConsole</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>com.unoplatform.pacconsole</ApplicationId>
    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Package Publisher -->
    <ApplicationPublisher>PacConsole</ApplicationPublisher>
    <!-- Package Description -->
    <Description>PacConsole powered by Uno Platform.</Description>

    <!--
      UnoFeatures are used to quickly add and manage features enabled for your app.
      https://aka.platform.uno/singleproject-features
    -->
    <!-- An API Uno Platform does not implement fails the build instead of doing nothing at runtime. -->
    <WarningsAsErrors>$(WarningsAsErrors);Uno0001</WarningsAsErrors>
    <UnoFeatures>
      SimpleTheme;
      Hosting;
      Toolkit;
      Logging;
      MVUX;
      Navigation;
      SkiaRenderer;
    </UnoFeatures>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PacConsole.Core\PacConsole.Core.csproj" />
  </ItemGroup>

</Project>
