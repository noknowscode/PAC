<UserControl x:Class="PacConsole.Presentation.ConsoleHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:utu="using:Uno.Toolkit.UI"
             xmlns:controls="using:PacConsole.Controls">

  <!--
    The console header (SPEC-CONSOLE.md): one band for the whole station. Where (the plant), what it makes (net output
    against its target), how it runs (mode and data age), and who is at the desk. DataContext: the console FeedView's
    state, so Data is the ConsoleView and Parent the page model.
  -->

  <UserControl.Resources>
    <!-- One template per piece; the ResponsiveView below arranges them per category. -->
    <DataTemplate x:Key="HeaderBrandTemplate">
      <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space14}" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
          <FontIcon Glyph="&#xE81E;" FontSize="{StaticResource IconSize}" Foreground="{ThemeResource AlertBrush}" VerticalAlignment="Center"
                    AutomationProperties.AccessibilityView="Raw" />
          <TextBlock Text="PAC" Style="{StaticResource TypeTitle}" VerticalAlignment="Center" />
        </StackPanel>
        <Border Style="{StaticResource VerticalRule}" Height="{StaticResource HeaderRuleHeight}" VerticalAlignment="Center" />
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Plant 02" Style="{StaticResource TypeTitle}" />
          <TextBlock Text="Steam-cycle station" Style="{StaticResource TypeMicro}"
                     Visibility="{utu:Responsive Layout={StaticResource ConsoleLayout}, Narrow=Collapsed, Normal=Visible}" />
        </StackPanel>
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="HeaderOutputTemplate">
      <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space10}" VerticalAlignment="Center">
        <TextBlock Text="Net output" Style="{StaticResource TypeBody}" VerticalAlignment="Bottom" Margin="{StaticResource BaselineGap}" />
        <TextBlock Text="{Binding Data.OutputNow}" Style="{StaticResource TypeDisplay}" />
        <TextBlock Text="MW" Style="{StaticResource TypeBody}" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Bottom" Margin="{StaticResource BaselineGap}" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="HeaderTargetTemplate">
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="{Binding Data.TargetGapText}" Style="{StaticResource TypeBody}" />
        <TextBlock Text="{Binding Data.TargetText}" Style="{StaticResource TypeMicro}" />
      </StackPanel>
    </DataTemplate>

    <!-- Mode and data age, right-aligned on two lines (Normal up). -->
    <DataTemplate x:Key="HeaderStatusTemplate">
      <StackPanel VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}" HorizontalAlignment="Right">
          <Ellipse Width="{StaticResource DotSizeLive}" Height="{StaticResource DotSizeLive}" controls:Pulse.IsEnabled="{Binding Data.DataIsLive}" VerticalAlignment="Center"
                   Fill="{Binding Data.DataIsLive, Converter={StaticResource Tone}, ConverterParameter='True=AccentBrush|False=FaintBrush'}" />
          <TextBlock Text="{Binding Data.ModeLine}" Style="{StaticResource TypeBody}" />
        </StackPanel>
        <TextBlock Text="{Binding Data.SnapshotText}" Style="{StaticResource TypeMicro}" HorizontalAlignment="Right" />
      </StackPanel>
    </DataTemplate>

    <!-- The same on one wrapping line (phones). -->
    <DataTemplate x:Key="HeaderStatusInlineTemplate">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Space8}">
        <Ellipse Width="{StaticResource DotSizeLive}" Height="{StaticResource DotSizeLive}" controls:Pulse.IsEnabled="{Binding Data.DataIsLive}" VerticalAlignment="Center"
                 Fill="{Binding Data.DataIsLive, Converter={StaticResource Tone}, ConverterParameter='True=AccentBrush|False=FaintBrush'}" />
        <TextBlock Grid.Column="1" Style="{StaticResource TypeMicro}" TextWrapping="WrapWholeWords" VerticalAlignment="Center">
          <Run Text="{Binding Data.ModeLine}" Foreground="{ThemeResource TextPrimaryBrush}" /><Run Text=" · " /><Run Text="{Binding Data.SnapshotText}" />
        </TextBlock>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="HeaderActionsTemplate">
      <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space4}" VerticalAlignment="Center">
        <Button Style="{utu:Responsive Layout={StaticResource ConsoleLayout}, Narrow={StaticResource IconButtonTouch}, Wide={StaticResource IconButton}}"
                AutomationProperties.Name="More" ToolTipService.ToolTip="More">
          <FontIcon Glyph="&#xE712;" FontSize="{StaticResource IconSize}" />
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight">
              <RadioMenuFlyoutItem Text="System theme" GroupName="Theme" IsChecked="{Binding Data.IsThemeSystem, Mode=OneWay}"
                                   Command="{Binding Parent.SetTheme}" CommandParameter="System" />
              <RadioMenuFlyoutItem Text="Light theme" GroupName="Theme" IsChecked="{Binding Data.IsThemeLight, Mode=OneWay}"
                                   Command="{Binding Parent.SetTheme}" CommandParameter="Light" />
              <RadioMenuFlyoutItem Text="Graphite theme" GroupName="Theme" IsChecked="{Binding Data.IsThemeGraphite, Mode=OneWay}"
                                   Command="{Binding Parent.SetTheme}" CommandParameter="Graphite" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
        <Button Style="{utu:Responsive Layout={StaticResource ConsoleLayout}, Narrow={StaticResource IconButtonTouch}, Wide={StaticResource IconButton}}"
                Command="{utu:AncestorBinding AncestorType=Page, Path=ToggleFullScreen}"
                Visibility="{utu:AncestorBinding AncestorType=Page, Path=FullScreenVisibility}"
                AutomationProperties.Name="Full screen" ToolTipService.ToolTip="Full screen">
          <FontIcon Glyph="&#xE740;" FontSize="{StaticResource IconSizeSm}" />
        </Button>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <Border BorderBrush="{ThemeResource HairlineBrush}" BorderThickness="0,0,0,1">
    <utu:ResponsiveView ResponsiveLayout="{StaticResource ConsoleLayout}" HorizontalContentAlignment="Stretch">
      <!-- Phone: the mark and the menu; net output against target; mode and data age on one line.
           Each row is its own grid, so one row's widths never push another's. -->
      <utu:ResponsiveView.NarrowTemplate>
        <DataTemplate>
          <StackPanel Spacing="{StaticResource Space6}" Padding="{StaticResource HeaderInsetNarrow}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space12}">
              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource HeaderBrandTemplate}" IsTabStop="False" VerticalAlignment="Center" />
              <ContentControl Grid.Column="1" Content="{Binding}" ContentTemplate="{StaticResource HeaderActionsTemplate}" IsTabStop="False" />
            </Grid>
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource Space12}">
              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource HeaderOutputTemplate}" IsTabStop="False" />
              <ContentControl Grid.Column="2" Content="{Binding}" ContentTemplate="{StaticResource HeaderTargetTemplate}" IsTabStop="False" VerticalAlignment="Center" />
            </Grid>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource HeaderStatusInlineTemplate}" IsTabStop="False" HorizontalContentAlignment="Stretch" />
          </StackPanel>
        </DataTemplate>
      </utu:ResponsiveView.NarrowTemplate>
      <!-- Tablet: the station, its status and the menu; net output against target below. -->
      <utu:ResponsiveView.NormalTemplate>
        <DataTemplate>
          <StackPanel Spacing="{StaticResource Space8}" Padding="{StaticResource HeaderInset}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="{StaticResource Space20}">
              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource HeaderBrandTemplate}" IsTabStop="False" VerticalAlignment="Center" />
              <ContentControl Grid.Column="2" Content="{Binding}" ContentTemplate="{StaticResource HeaderStatusTemplate}" IsTabStop="False" VerticalAlignment="Center" />
              <ContentControl Grid.Column="3" Content="{Binding}" ContentTemplate="{StaticResource HeaderActionsTemplate}" IsTabStop="False" VerticalAlignment="Center" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space20}">
              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource HeaderOutputTemplate}" IsTabStop="False" />
              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource HeaderTargetTemplate}" IsTabStop="False" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </DataTemplate>
      </utu:ResponsiveView.NormalTemplate>
      <!-- Desktop: one row. The operator is named from Widest, where the row has room for it. -->
      <utu:ResponsiveView.WideTemplate>
        <DataTemplate>
          <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="{StaticResource Space20}" Padding="{StaticResource HeaderInset}">
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource HeaderBrandTemplate}" IsTabStop="False" VerticalAlignment="Center" />
            <Border Grid.Column="1" Style="{StaticResource VerticalRule}" Margin="{StaticResource InsetY6}" />
            <ContentControl Grid.Column="2" Content="{Binding}" ContentTemplate="{StaticResource HeaderOutputTemplate}" IsTabStop="False" VerticalAlignment="Center" />
            <ContentControl Grid.Column="3" Content="{Binding}" ContentTemplate="{StaticResource HeaderTargetTemplate}" IsTabStop="False" VerticalAlignment="Center" />
            <ContentControl Grid.Column="5" Content="{Binding}" ContentTemplate="{StaticResource HeaderStatusTemplate}" IsTabStop="False" VerticalAlignment="Center" />
            <TextBlock Grid.Column="6" Text="Operator 04" Style="{StaticResource TypeMicro}" VerticalAlignment="Center" Margin="{StaticResource InsetX4}"
                       Visibility="{utu:Responsive Layout={StaticResource ConsoleLayout}, Wide=Collapsed, Widest=Visible}" />
            <ContentControl Grid.Column="7" Content="{Binding}" ContentTemplate="{StaticResource HeaderActionsTemplate}" IsTabStop="False" VerticalAlignment="Center" />
          </Grid>
        </DataTemplate>
      </utu:ResponsiveView.WideTemplate>
    </utu:ResponsiveView>
  </Border>
</UserControl>
