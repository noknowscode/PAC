<Page x:Class="PacConsole.Presentation.ConsolePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mvux="using:Uno.Extensions.Reactive.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:controls="using:PacConsole.Controls"
      xmlns:charts="using:PacConsole.Controls.Charts"
      xmlns:rendering="using:PacConsole.Rendering"
      xmlns:conv="using:PacConsole.Presentation.Converters"
      NavigationCacheMode="Required"
      Background="{StaticResource GroundBrush}">

  <Page.Resources>
    <conv:ToneConverter x:Key="Tone" />
    <conv:BoolToVisibilityConverter x:Key="Visible" />

    <!-- Slider lightweight styling: accent value track and thumb on a faint cyan track. -->
    <StaticResource x:Key="SliderTrackValueFill" ResourceKey="AccentBrush" />
    <StaticResource x:Key="SliderTrackValueFillPointerOver" ResourceKey="AccentBrush" />
    <StaticResource x:Key="SliderTrackValueFillPressed" ResourceKey="AccentBrush" />
    <StaticResource x:Key="SliderThumbBackground" ResourceKey="AccentBrush" />
    <StaticResource x:Key="SliderThumbBackgroundPointerOver" ResourceKey="AccentBrush" />
    <StaticResource x:Key="SliderThumbBackgroundPressed" ResourceKey="AccentBrush" />
    <StaticResource x:Key="SliderTrackFill" ResourceKey="CyanFillBrush" />
    <StaticResource x:Key="SliderTrackFillPointerOver" ResourceKey="CyanFillBrush" />
    <StaticResource x:Key="SliderTrackFillPressed" ResourceKey="CyanFillBrush" />

    <!-- Below 1360 px the two-column console no longer fits: the telemetry column stacks under the plant. -->
    <utu:ResponsiveLayout x:Key="ConsoleLayout" Normal="0" Wide="1360" />

    <Style x:Key="CardHeader" TargetType="TextBlock" BasedOn="{StaticResource TypeMicro}">
      <Setter Property="CharacterSpacing" Value="160" />
    </Style>
  </Page.Resources>

  <Grid>
    <!-- Faint 32 px cyan grid behind everything (static asset, 2560×1440). -->
    <Image x:Name="Backdrop"
           Source="ms-appx:///Assets/Backdrop/grid.png"
           Stretch="None"
           HorizontalAlignment="Left"
           VerticalAlignment="Top"
           IsHitTestVisible="False" />

    <mvux:FeedView Source="{Binding View}" Margin="20">

      <!-- Before the first snapshot: the frame at its final size, so nothing jumps. -->
      <mvux:FeedView.ProgressTemplate>
        <DataTemplate>
          <Border BorderBrush="{StaticResource BorderBrushStrong}" BorderThickness="1" CornerRadius="{StaticResource RadiusPanel}" Background="{StaticResource PanelBrush}">
            <TextBlock Text="CONNECTING TO PLANT 02 …" Style="{StaticResource TypeSection}" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </DataTemplate>
      </mvux:FeedView.ProgressTemplate>

      <!-- Stream fault: say so plainly and offer a retry that re-runs the feed. -->
      <mvux:FeedView.ErrorTemplate>
        <DataTemplate>
          <Border BorderBrush="{StaticResource AlertBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusPanel}" Background="{StaticResource PanelBrush}">
            <StackPanel Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock Text="LINK LOST" Style="{StaticResource TypeTitle}" Foreground="{StaticResource AlertTextBrush}" HorizontalAlignment="Center" />
              <TextBlock Text="Telemetry stopped. The last values are no longer current." Style="{StaticResource TypeBody}" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
              <Button Content="RETRY" Command="{Binding Refresh}" Style="{StaticResource ToolbarButton}" HorizontalAlignment="Center" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </mvux:FeedView.ErrorTemplate>

      <DataTemplate>
        <!-- The glass panel: flat, per Uno Simple; a strong cyan hairline carries the edge. -->
        <Border Background="{StaticResource PanelBrush}"
                  BorderBrush="{StaticResource BorderBrushStrong}"
                  BorderThickness="1"
                  CornerRadius="{StaticResource RadiusPanel}"
                  Padding="20">
            <Grid RowDefinitions="48,*" RowSpacing="16">

              <!-- ============ HEADER ============ -->
              <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="16">
                <Border Width="40" Height="40" CornerRadius="8" BorderThickness="1"
                        BorderBrush="{StaticResource BorderBrushStrong}" Background="{StaticResource CyanTintBrush}">
                  <Path Data="M12 3a9 9 0 1 0 0.01 0zM12 8a4 4 0 1 0 0.01 0zM12 3v3M12 18v3M3 12h3M18 12h3"
                        Style="{StaticResource PathIconStyle}" Width="22" Height="22" Stroke="{StaticResource CyanBrush}" StrokeThickness="1.5" />
                </Border>
                <TextBlock Grid.Column="1" Text="CENTRAL CONTROL UNIT (PAC)" Style="{StaticResource TypeTitle}" VerticalAlignment="Center" />
                <Border Grid.Column="2" Width="1" Height="24" Background="{StaticResource BorderBrushDefault}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6"
                            Visibility="{utu:Responsive Layout={StaticResource ConsoleLayout}, Normal=Collapsed, Wide=Visible}">
                  <TextBlock Text="PLANT 02 · THERMAL /" Style="{StaticResource TypeBody}" Foreground="{StaticResource MutedBrush}" />
                  <TextBlock x:Name="Breadcrumb" Text="OVERVIEW" Style="{StaticResource TypeBody}" />
                </StackPanel>

                <Button Grid.Column="5"
                        Command="{Binding Parent.SelectFirstAlert}"
                        Style="{StaticResource ConsoleButton}"
                        Height="36" CornerRadius="18" Padding="14,0"
                        Background="{Binding Data.HasAlert, Converter={StaticResource Tone}, ConverterParameter=True=AlertTintBrush|False=CyanTintBrush}"
                        BorderBrush="{Binding Data.HasAlert, Converter={StaticResource Tone}, ConverterParameter=True=AlertBorderBrush|False=BorderBrushDefault}"
                        Foreground="{Binding Data.HasAlert, Converter={StaticResource Tone}, ConverterParameter=True=AlertTextBrush|False=CyanBrush}"
                        AutomationProperties.Name="{Binding Data.AlertText}"
                        ToolTipService.ToolTip="Select the first alerting unit">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse Width="7" Height="7" VerticalAlignment="Center" controls:Pulse.IsEnabled="True"
                             Fill="{Binding Data.HasAlert, Converter={StaticResource Tone}, ConverterParameter=True=AlertTextBrush|False=CyanBrush}" />
                    <TextBlock Text="{Binding Data.AlertText}" Style="{StaticResource ControlLabel}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>

                <ToggleButton x:Name="ThemeToggle" Grid.Column="6" Style="{StaticResource ToolbarToggleButton}"
                              Click="OnThemeClick" VerticalAlignment="Center"
                              AutomationProperties.Name="Light theme" ToolTipService.ToolTip="Switch between the dark and light themes">
                  <TextBlock Text="LIGHT" Style="{StaticResource ControlLabel}" />
                </ToggleButton>

                <StackPanel Grid.Column="7" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2">
                  <TextBlock Text="{Binding Data.Clock}" Style="{StaticResource TypeValue}" HorizontalAlignment="Right" />
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="0">
                    <TextBlock Text="{Binding Data.DataText}" Style="{StaticResource TypeMicro}"
                               Foreground="{Binding Data.DataTone, Converter={StaticResource Tone}, ConverterParameter=stale=AlertTextBrush|held=AccentBrush|live=MutedBrush}" />
                    <TextBlock Text=" · OPERATOR 04" Style="{StaticResource TypeMicro}" />
                  </StackPanel>
                </StackPanel>
              </Grid>

              <!-- ============ BODY ============ -->
              <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto" Margin="0,0,-12,0" Padding="0,0,12,0">
              <Grid ColumnDefinitions="*,500" RowDefinitions="*,Auto" ColumnSpacing="16"
                    RowSpacing="{utu:Responsive Layout={StaticResource ConsoleLayout}, Normal=16, Wide=0}"
                    MinHeight="{utu:Responsive Layout={StaticResource ConsoleLayout}, Normal=1400, Wide=680}">

                <!-- ============ OVERVIEW: main column ============ -->
                <Grid x:Name="OverviewMain" RowDefinitions="*,200" RowSpacing="16"
                      Grid.ColumnSpan="{utu:Responsive Layout={StaticResource ConsoleLayout}, Normal=2, Wide=1}">

                  <Grid>
                    <controls:PlantViewport x:Name="Viewport"
                                            SelectedUnit="{Binding Data.Selected}"
                                            AlertingUnits="{Binding Data.AlertingUnits}"
                                            SelectCommand="{Binding Parent.SelectUnit}"
                                            Loaded="OnViewportLoaded" />
                  </Grid>

                  <!-- Bottom row: control panel + camera presets -->
                  <Grid Grid.Row="1" ColumnDefinitions="316,*,*,*" ColumnSpacing="12">
                    <Border Padding="12" CornerRadius="{StaticResource RadiusCard}" BorderThickness="1"
                            BorderBrush="{StaticResource AccentBorderBrush}" Background="{StaticResource AccentTintBrush}"
                            AutomationProperties.Name="Unit control">
                      <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
                        <Grid>
                          <TextBlock Text="CONTROL" Style="{StaticResource TypeSection}" Foreground="{StaticResource AccentBrush}" />
                          <TextBlock Text="UNIT SELECT" Style="{StaticResource CardHeader}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <ItemsRepeater Grid.Row="1" ItemsSource="{Binding Data.Units}">
                          <ItemsRepeater.Layout>
                            <UniformGridLayout MaximumRowsOrColumns="3" MinItemWidth="60" MinItemHeight="48"
                                               MinColumnSpacing="8" MinRowSpacing="8" ItemsStretch="Fill" />
                          </ItemsRepeater.Layout>
                          <ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                              <Button Style="{StaticResource ConsoleButton}" Height="48" Padding="0" HorizontalAlignment="Stretch"
                                      Command="{utu:AncestorBinding AncestorType=Page, Path=DataContext.SelectUnit}"
                                      CommandParameter="{Binding Id}"
                                      AutomationProperties.Name="{Binding AutomationName}"
                                      Background="{Binding Tone, Converter={StaticResource Tone}, ConverterParameter=selected=AccentFillBrush|normal=CardBrush}"
                                      BorderBrush="{Binding Tone, Converter={StaticResource Tone}, ConverterParameter=selected=AccentBrush|alert=AlertBorderBrush|normal=BorderBrushDefault}">
                                <StackPanel Spacing="2" HorizontalAlignment="Center">
                                  <TextBlock Text="{Binding ShortCode}" Style="{StaticResource TypeCode}" HorizontalAlignment="Center"
                                             Foreground="{Binding Tone, Converter={StaticResource Tone}, ConverterParameter=selected=AccentBrush|normal=TextPrimaryBrush}" />
                                  <TextBlock Text="{Binding Subtitle}" Style="{StaticResource TypeMicro}" HorizontalAlignment="Center"
                                             Foreground="{Binding Tone, Converter={StaticResource Tone}, ConverterParameter=alert=AlertTextBrush|selected=AccentBrush|normal=FaintBrush}" />
                                </StackPanel>
                              </Button>
                            </DataTemplate>
                          </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,*,*" ColumnSpacing="6">
                          <TextBlock Text="MODE" Style="{StaticResource CardHeader}" VerticalAlignment="Center" Margin="0,0,4,0" />
                          <RadioButton Grid.Column="1" Content="AUTO" Style="{StaticResource ModeRadioButton}" IsChecked="{Binding Data.IsAuto, Mode=OneWay}" Command="{Binding Parent.SetAuto}" />
                          <RadioButton Grid.Column="2" Content="MAN" Style="{StaticResource ModeRadioButton}" IsChecked="{Binding Data.IsManual, Mode=OneWay}" Command="{Binding Parent.SetManual}" />
                          <RadioButton Grid.Column="3" Content="HOLD" Style="{StaticResource ModeRadioButton}" IsChecked="{Binding Data.IsHold, Mode=OneWay}" Command="{Binding Parent.SetHold}" />
                        </Grid>
                      </Grid>
                    </Border>

                    <Button x:Name="PresetIso" Grid.Column="1" Tag="iso" Click="OnPresetClick" Style="{StaticResource ConsoleButton}"
                            Padding="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                            CornerRadius="{StaticResource RadiusCard}" AutomationProperties.Name="Camera preset ISO">
                      <Grid RowDefinitions="Auto,*,Auto" RowSpacing="6">
                        <TextBlock Text="ISO · NE" Style="{StaticResource CardHeader}" />
                        <rendering:SolidThumb Grid.Row="1" PresetKey="iso" Selected="{Binding Data.Selected}" AlertingUnits="{Binding Data.AlertingUnits}" />
                        <TextBlock Grid.Row="2" Text="YAW 35° / EL 28°" Style="{StaticResource TypeMicro}" Foreground="{StaticResource FaintBrush}" />
                      </Grid>
                    </Button>
                    <Button x:Name="PresetElevation" Grid.Column="2" Tag="elevation" Click="OnPresetClick" Style="{StaticResource ConsoleButton}"
                            Padding="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                            CornerRadius="{StaticResource RadiusCard}" AutomationProperties.Name="Camera preset elevation">
                      <Grid RowDefinitions="Auto,*,Auto" RowSpacing="6">
                        <TextBlock Text="ELEVATION · S" Style="{StaticResource CardHeader}" />
                        <rendering:SolidThumb Grid.Row="1" PresetKey="elevation" Selected="{Binding Data.Selected}" AlertingUnits="{Binding Data.AlertingUnits}" />
                        <TextBlock Grid.Row="2" Text="YAW 0° / EL 6°" Style="{StaticResource TypeMicro}" Foreground="{StaticResource FaintBrush}" />
                      </Grid>
                    </Button>
                    <Button x:Name="PresetPlan" Grid.Column="3" Tag="plan" Click="OnPresetClick" Style="{StaticResource ConsoleButton}"
                            Padding="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                            CornerRadius="{StaticResource RadiusCard}" AutomationProperties.Name="Camera preset plan">
                      <Grid RowDefinitions="Auto,*,Auto" RowSpacing="6">
                        <TextBlock Text="PLAN" Style="{StaticResource CardHeader}" />
                        <rendering:SolidThumb Grid.Row="1" PresetKey="plan" Selected="{Binding Data.Selected}" AlertingUnits="{Binding Data.AlertingUnits}" />
                        <TextBlock Grid.Row="2" Text="YAW 0° / EL 86°" Style="{StaticResource TypeMicro}" Foreground="{StaticResource FaintBrush}" />
                      </Grid>
                    </Button>
                  </Grid>
                </Grid>

                <!-- ============ OVERVIEW: telemetry column ============ -->
                <Grid x:Name="OverviewAside" ColumnDefinitions="*,*,*" RowDefinitions="190,170,*,Auto"
                      Grid.Column="{utu:Responsive Layout={StaticResource ConsoleLayout}, Normal=0, Wide=1}"
                      Grid.Row="{utu:Responsive Layout={StaticResource ConsoleLayout}, Normal=1, Wide=0}"
                      Grid.ColumnSpan="{utu:Responsive Layout={StaticResource ConsoleLayout}, Normal=2, Wide=1}"
                      ColumnSpacing="12" RowSpacing="12" AutomationProperties.Name="Telemetry">

                  <!-- Net output -->
                  <Border Grid.ColumnSpan="2" Style="{StaticResource CardStyle}">
                    <Grid RowDefinitions="42,*" RowSpacing="4">
                      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                        <Ellipse Width="6" Height="6" controls:Pulse.IsEnabled="True" VerticalAlignment="Center"
                                 Fill="{Binding Data.DataIsLive, Converter={StaticResource Tone}, ConverterParameter=True=AccentBrush|False=MutedBrush}" />
                        <TextBlock Style="{StaticResource CardHeader}">
                          <Run Text="NET OUTPUT · " /><Run Text="{Binding Data.LiveText}" />
                        </TextBlock>
                      </StackPanel>
                      <StackPanel HorizontalAlignment="Right" Spacing="2">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                          <TextBlock Text="{Binding Data.OutputNow}" Style="{StaticResource TypeFigure}" Foreground="{StaticResource AccentBrush}" />
                          <TextBlock Text="MW" Style="{StaticResource TypeBody}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom" Margin="0,0,0,3" />
                        </StackPanel>
                        <TextBlock Text="{Binding Data.OutputDelta}" Style="{StaticResource TypeMicro}" HorizontalAlignment="Right" />
                      </StackPanel>
                      <charts:OutputChart Grid.Row="1" Values="{Binding Data.OutputSeries}" Target="{Binding Data.TargetMw}" />
                    </Grid>
                  </Border>

                  <!-- Unit preview -->
                  <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <Grid RowDefinitions="Auto,*,Auto,Auto,Auto" RowSpacing="4">
                      <TextBlock Text="UNIT PREVIEW" Style="{StaticResource CardHeader}" />
                      <rendering:SolidThumb Grid.Row="1" SingleUnit="True" Selected="{Binding Data.Selected}" AlertingUnits="{Binding Data.AlertingUnits}" PresetKey="iso" />
                      <TextBlock Grid.Row="2" Text="{Binding Data.SelectedCode}" Style="{StaticResource TypeCode}" Foreground="{StaticResource AccentBrush}" />
                      <TextBlock Grid.Row="3" Text="{Binding Data.SelectedName}" Style="{StaticResource TypeMicro}" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Row="4" Style="{StaticResource TypeMicro}">
                        <Run Text="UP " /><Run Text="{Binding Data.SelectedUptime}" /><LineBreak /><Run Text="SERVICED " /><Run Text="{Binding Data.SelectedService}" />
                      </TextBlock>
                    </Grid>
                  </Border>

                  <!-- Telemetry tiles -->
                  <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource CardStyle}">
                    <Grid RowDefinitions="Auto,*" RowSpacing="8">
                      <Grid>
                        <TextBlock Style="{StaticResource CardHeader}"><Run Text="TELEMETRY · " /><Run Text="{Binding Data.SelectedCode}" /></TextBlock>
                        <TextBlock Text="{Binding Data.SelectedStatusLine}" Style="{StaticResource CardHeader}" HorizontalAlignment="Right"
                                   Foreground="{Binding Data.SelectedIsAlert, Converter={StaticResource Tone}, ConverterParameter=True=AlertTextBrush|False=CyanBrush}" />
                      </Grid>
                      <ItemsRepeater Grid.Row="1" ItemsSource="{Binding Data.Tiles}">
                        <ItemsRepeater.Layout>
                          <UniformGridLayout MaximumRowsOrColumns="3" MinItemWidth="60" MinItemHeight="56"
                                             MinColumnSpacing="6" MinRowSpacing="6" ItemsStretch="Fill" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                          <DataTemplate>
                            <Border Padding="8,6" CornerRadius="6" BorderThickness="1" Background="{StaticResource CyanTintBrush}"
                                    BorderBrush="{Binding Tone, Converter={StaticResource Tone}, ConverterParameter=high=AlertBorderBrush|normal=HairlineBrush}">
                              <Grid RowDefinitions="Auto,*">
                                <TextBlock Text="{Binding Label}" Style="{StaticResource TypeMicro}" />
                                <TextBlock Text="{Binding Status}" Style="{StaticResource TypeMicro}" HorizontalAlignment="Right"
                                           Foreground="{Binding Tone, Converter={StaticResource Tone}, ConverterParameter=high=AlertTextBrush|normal=FaintBrush}" />
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom">
                                  <TextBlock Text="{Binding Value}" Style="{StaticResource TypeValue}"
                                             Foreground="{Binding Tone, Converter={StaticResource Tone}, ConverterParameter=high=AlertTextBrush|held=MutedBrush|normal=TextPrimaryBrush}" />
                                  <TextBlock Text="{Binding Unit}" Style="{StaticResource TypeMicro}" VerticalAlignment="Bottom" Margin="0,0,0,3" />
                                </StackPanel>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                      </ItemsRepeater>
                    </Grid>
                  </Border>

                  <!-- Valves -->
                  <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource CardStyle}">
                    <Grid RowDefinitions="Auto,*" RowSpacing="8">
                      <TextBlock Text="VALVES" Style="{StaticResource CardHeader}" />
                      <TextBlock Text="{Binding Data.OpenValvesText}" Style="{StaticResource CardHeader}" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                      <ItemsRepeater Grid.Row="1" ItemsSource="{Binding Data.Valves}">
                        <ItemsRepeater.Layout>
                          <UniformGridLayout MaximumRowsOrColumns="3" MinItemWidth="30" MinItemHeight="36"
                                             MinColumnSpacing="6" MinRowSpacing="6" ItemsStretch="Fill" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                          <DataTemplate>
                            <ToggleButton Style="{StaticResource ValveToggleButton}"
                                          IsChecked="{Binding Open, Mode=OneWay}"
                                          Command="{utu:AncestorBinding AncestorType=Page, Path=DataContext.ToggleValve}"
                                          CommandParameter="{Binding Id}"
                                          AutomationProperties.Name="{Binding AutomationName}">
                              <StackPanel Spacing="1" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Number}" Style="{StaticResource ValveNumber}" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding State}" Style="{StaticResource ValveState}" HorizontalAlignment="Center" />
                              </StackPanel>
                            </ToggleButton>
                          </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                      </ItemsRepeater>
                    </Grid>
                  </Border>

                  <!-- Hourly generation -->
                  <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource CardStyle}" MinHeight="170">
                    <Grid RowDefinitions="Auto,*" RowSpacing="8">
                      <TextBlock Text="HOURLY GENERATION · MWh" Style="{StaticResource CardHeader}" />
                      <TextBlock Style="{StaticResource CardHeader}" HorizontalAlignment="Right">
                        <Run Text="PEAK " /><Run Text="{Binding Data.HourlyPeak}" Foreground="{StaticResource TextPrimaryBrush}" />
                      </TextBlock>
                      <charts:HourlyChart Grid.Row="1" Values="{Binding Data.HourlySeries}" />
                    </Grid>
                  </Border>

                  <!-- Vibration -->
                  <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource CardStyle}" MinHeight="170"
                          BorderBrush="{Binding Data.VibrationIsHigh, Converter={StaticResource Tone}, ConverterParameter=True=AlertBorderBrush|False=HairlineBrush}">
                    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="4">
                      <TextBlock Text="VIBRATION TREND" Style="{StaticResource CardHeader}" />
                      <TextBlock Text="{Binding Data.VibrationStatus}" Style="{StaticResource CardHeader}" HorizontalAlignment="Right"
                                 Foreground="{Binding Data.VibrationIsHigh, Converter={StaticResource Tone}, ConverterParameter=True=AlertTextBrush|False=CyanBrush}" />
                      <charts:VibrationChart Grid.Row="2" Values="{Binding Data.VibrationSeries}" IsHigh="{Binding Data.VibrationIsHigh}" />
                      <Grid Grid.Row="3">
                        <TextBlock Text="LIMIT 4.5" Style="{StaticResource TypeMicro}" />
                        <TextBlock Text="{Binding Data.VibrationZone}" Style="{StaticResource TypeMicro}" HorizontalAlignment="Right"
                                   Foreground="{Binding Data.VibrationIsHigh, Converter={StaticResource Tone}, ConverterParameter=True=AlertTextBrush|False=CyanBrush}" />
                      </Grid>
                    </Grid>
                  </Border>

                  <!-- Setpoints -->
                  <Border Grid.Row="3" Grid.ColumnSpan="3" Style="{StaticResource CardStyle}" Padding="14,12">
                    <Grid RowDefinitions="Auto,*" RowSpacing="12">
                      <TextBlock Text="SETPOINTS" Style="{StaticResource CardHeader}" />
                      <TextBlock Style="{StaticResource CardHeader}" HorizontalAlignment="Right">
                        <Run Text="MODE " /><Run Text="{Binding Data.ModeText}" Foreground="{StaticResource TextPrimaryBrush}" />
                      </TextBlock>
                      <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="20">
                        <StackPanel Spacing="4">
                          <TextBlock Text="OUTPUT TARGET" Style="{StaticResource TypeMicro}" />
                          <TextBlock Style="{StaticResource TypeFigure}">
                            <Run Text="{Binding Parent.TargetMw}" /><Run Text=" MW" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                          </TextBlock>
                          <Slider Minimum="400" Maximum="700" StepFrequency="5" SmallChange="5" LargeChange="50"
                                  Value="{Binding Parent.TargetMw, Mode=TwoWay}" AutomationProperties.Name="Output target, megawatts" />
                          <TextBlock Text="Dashed on output chart" Style="{StaticResource TypeMicro}" CharacterSpacing="0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                          <TextBlock Text="TRB INLET LIMIT" Style="{StaticResource TypeMicro}" />
                          <TextBlock Style="{StaticResource TypeFigure}">
                            <Run Text="{Binding Parent.TurbineLimitBar}" /><Run Text=" bar" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                          </TextBlock>
                          <Slider Minimum="140" Maximum="180" StepFrequency="1" SmallChange="1" LargeChange="10"
                                  Value="{Binding Parent.TurbineLimitBar, Mode=TwoWay}" AutomationProperties.Name="Turbine inlet pressure limit, bar" />
                          <TextBlock Text="TRB-04 alarms above" Style="{StaticResource TypeMicro}" CharacterSpacing="0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4">
                          <TextBlock Text="STACK DAMPER" Style="{StaticResource TypeMicro}" />
                          <TextBlock Style="{StaticResource TypeFigure}">
                            <Run Text="{Binding Parent.DamperPct}" /><Run Text=" %" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                          </TextBlock>
                          <Slider Minimum="0" Maximum="100" StepFrequency="1" SmallChange="1" LargeChange="10"
                                  Value="{Binding Parent.DamperPct, Mode=TwoWay}" AutomationProperties.Name="Stack damper, percent" />
                          <TextBlock Text="Scales STK-01 flow" Style="{StaticResource TypeMicro}" CharacterSpacing="0" />
                        </StackPanel>
                      </Grid>
                    </Grid>
                  </Border>
                </Grid>
              </Grid>
              </ScrollViewer>
            </Grid>
          </Border>
      </DataTemplate>
    </mvux:FeedView>
  </Grid>
</Page>
