<Page x:Class="PacConsole.Presentation.ConsolePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mvux="using:Uno.Extensions.Reactive.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:controls="using:PacConsole.Controls"
      xmlns:charts="using:PacConsole.Controls.Charts"
      xmlns:rendering="using:PacConsole.Rendering"
      xmlns:conv="using:PacConsole.Presentation.Converters"
      NavigationCacheMode="Required"
      Background="{StaticResource GroundBrush}">

  <!--
    A figure plate and a datasheet (.impeccable.md, Direction 2). The plant is Fig. 1, drawn straight
    on the ground; readings sit in one column separated by space and single hairline rules, with no
    cards. Net output is the one display-size figure. Orange marks the selected unit and live data only.
  -->

  <Page.Resources>
    <conv:ToneConverter x:Key="Tone" />
    <conv:BoolToVisibilityConverter x:Key="Visible" />

    <!-- Slider lightweight styling: an ink value track on a soft fill, orange thumb (the control you hold). -->
    <StaticResource x:Key="SliderTrackValueFill" ResourceKey="InkSoftBrush" />
    <StaticResource x:Key="SliderTrackValueFillPointerOver" ResourceKey="TextPrimaryBrush" />
    <StaticResource x:Key="SliderTrackValueFillPressed" ResourceKey="TextPrimaryBrush" />
    <StaticResource x:Key="SliderThumbBackground" ResourceKey="AccentBrush" />
    <StaticResource x:Key="SliderThumbBackgroundPointerOver" ResourceKey="AccentBrush" />
    <StaticResource x:Key="SliderThumbBackgroundPressed" ResourceKey="AccentBrush" />
    <StaticResource x:Key="SliderTrackFill" ResourceKey="FillStrongBrush" />
    <StaticResource x:Key="SliderTrackFillPointerOver" ResourceKey="FillStrongBrush" />
    <StaticResource x:Key="SliderTrackFillPressed" ResourceKey="FillStrongBrush" />

    <!-- Below 1360 px the readings column no longer fits beside the figure: it stacks under it. -->
    <utu:ResponsiveLayout x:Key="ConsoleLayout" Normal="0" Wide="1360" />

    <!-- A datasheet rule between sections: a divider, not a container. -->
    <Style x:Key="Rule" TargetType="Border">
      <Setter Property="Height" Value="1" />
      <Setter Property="Background" Value="{StaticResource HairlineBrush}" />
    </Style>
  </Page.Resources>

  <mvux:FeedView x:Name="ConsoleFeed" Source="{Binding View}" Margin="32,20,32,24">

    <!-- Before the first snapshot: a quiet line where the page will be, so nothing jumps. -->
    <mvux:FeedView.ProgressTemplate>
      <DataTemplate>
        <TextBlock Text="Connecting to plant 02…" Style="{StaticResource TypeBody}" Foreground="{StaticResource MutedBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
      </DataTemplate>
    </mvux:FeedView.ProgressTemplate>

    <!-- Stream fault: say so plainly and offer a retry that re-runs the feed. The template's DataContext
         is the exception, so Retry reaches the FeedView by name (uno-runtime-gotchas, Binding). -->
    <mvux:FeedView.ErrorTemplate>
      <DataTemplate>
        <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="Telemetry stopped" Style="{StaticResource TypeTitle}" Foreground="{StaticResource AlertTextBrush}" HorizontalAlignment="Center" />
          <TextBlock Text="The last values are no longer current." Style="{StaticResource TypeBody}" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
          <Button Content="Retry" Command="{Binding Refresh, ElementName=ConsoleFeed}" Style="{StaticResource ConsoleButton}" HorizontalAlignment="Center" />
        </StackPanel>
      </DataTemplate>
    </mvux:FeedView.ErrorTemplate>

    <DataTemplate>
      <Grid RowDefinitions="44,*" RowSpacing="20">

        <!-- ============ HEADER: one line, left to right as it is read ============ -->
        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="20">
          <StackPanel VerticalAlignment="Center" Spacing="0">
            <TextBlock Text="Plant 02" Style="{StaticResource TypeTitle}" />
            <TextBlock Text="Thermal station · central control" Style="{StaticResource TypeMicro}" />
          </StackPanel>

          <Button Grid.Column="2"
                  Command="{Binding Parent.SelectFirstAlert}"
                  Style="{StaticResource ConsoleButton}"
                  Height="32" CornerRadius="16" Padding="12,0"
                  Background="{Binding Data.HasAlert, Converter={StaticResource Tone}, ConverterParameter=True=AlertTintBrush|False=FillBrush}"
                  Foreground="{Binding Data.HasAlert, Converter={StaticResource Tone}, ConverterParameter=True=AlertTextBrush|False=InkSoftBrush}"
                  AutomationProperties.Name="{Binding Data.AlertText}"
                  ToolTipService.ToolTip="Select the first unit in alert">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Ellipse Width="6" Height="6" VerticalAlignment="Center" controls:Pulse.IsEnabled="True"
                       Fill="{Binding Data.HasAlert, Converter={StaticResource Tone}, ConverterParameter=True=AlertBrush|False=FaintBrush}" />
              <TextBlock Text="{Binding Data.AlertText}" Style="{StaticResource ControlLabel}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <ToggleButton Grid.Column="3" Style="{StaticResource QuietToggleButton}"
                        Click="OnThemeClick" VerticalAlignment="Center"
                        AutomationProperties.Name="Dark theme" ToolTipService.ToolTip="Switch between the light and graphite themes">
            <TextBlock Text="Dark" Style="{StaticResource ControlLabel}" />
          </ToggleButton>

          <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="0" MinWidth="112">
            <TextBlock Text="{Binding Data.Clock}" Style="{StaticResource TypeCode}" HorizontalAlignment="Right" />
            <TextBlock Style="{StaticResource TypeMicro}" HorizontalAlignment="Right">
              <Run Text="{Binding Data.DataText}" Foreground="{Binding Data.DataTone, Converter={StaticResource Tone}, ConverterParameter=stale=AlertTextBrush|held=InkSoftBrush|live=MutedBrush}" /><Run Text=" · operator 04" />
            </TextBlock>
          </StackPanel>
        </Grid>

        <!-- ============ BODY ============ -->
        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="{utu:Responsive Layout={StaticResource ConsoleLayout}, Normal=Auto, Wide=Disabled}"
                      Margin="0,0,-16,0" Padding="0,0,16,0">
          <Grid ColumnDefinitions="*,440" RowDefinitions="*,Auto" ColumnSpacing="56"
                RowSpacing="{utu:Responsive Layout={StaticResource ConsoleLayout}, Normal=40, Wide=0}"
                MinHeight="{utu:Responsive Layout={StaticResource ConsoleLayout}, Normal=1500, Wide=600}">

            <!-- ============ FIG. 1: the plant, with units and views beneath it ============ -->
            <Grid RowDefinitions="*,Auto" RowSpacing="28"
                  Grid.ColumnSpan="{utu:Responsive Layout={StaticResource ConsoleLayout}, Normal=2, Wide=1}">

              <controls:PlantViewport x:Name="Viewport"
                                      SelectedUnit="{Binding Data.Selected}"
                                      AlertingUnits="{Binding Data.AlertingUnits}"
                                      SelectCommand="{Binding Parent.SelectUnit}"
                                      Loaded="OnViewportLoaded" />

              <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">

                <!-- Units and mode -->
                <StackPanel Spacing="10" AutomationProperties.Name="Unit control">
                  <TextBlock Text="Units" Style="{StaticResource TypeMicro}" />
                  <ItemsRepeater ItemsSource="{Binding Data.Units}">
                    <ItemsRepeater.Layout>
                      <StackLayout Orientation="Horizontal" Spacing="4" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                      <DataTemplate>
                        <Button Style="{StaticResource ConsoleButton}" Width="64" Height="48" Padding="0"
                                Command="{utu:AncestorBinding AncestorType=Page, Path=DataContext.SelectUnit}"
                                CommandParameter="{Binding Id}"
                                AutomationProperties.Name="{Binding AutomationName}"
                                Background="{Binding Tone, Converter={StaticResource Tone}, ConverterParameter=selected=CardBrush|normal=FillBrush}">
                          <StackPanel Spacing="0" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding ShortCode}" Style="{StaticResource TypeSection}" HorizontalAlignment="Center"
                                       Foreground="{Binding Tone, Converter={StaticResource Tone}, ConverterParameter=selected=AccentBrush|normal=TextPrimaryBrush}" />
                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource TypeMicro}" HorizontalAlignment="Center"
                                       Foreground="{Binding Tone, Converter={StaticResource Tone}, ConverterParameter=alert=AlertTextBrush|normal=MutedBrush}" />
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                  </ItemsRepeater>
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="Mode" Style="{StaticResource TypeMicro}" VerticalAlignment="Center" />
                    <!-- A segmented track: one soft fill, the chosen segment raised to white. -->
                    <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="2" Padding="3" CornerRadius="9" Background="{StaticResource FillBrush}">
                      <RadioButton Content="Auto" Style="{StaticResource ModeRadioButton}" Height="28" IsChecked="{Binding Data.IsAuto, Mode=OneWay}" Command="{Binding Parent.SetAuto}" />
                      <RadioButton Grid.Column="1" Content="Manual" Style="{StaticResource ModeRadioButton}" Height="28" IsChecked="{Binding Data.IsManual, Mode=OneWay}" Command="{Binding Parent.SetManual}" />
                      <RadioButton Grid.Column="2" Content="Hold" Style="{StaticResource ModeRadioButton}" Height="28" IsChecked="{Binding Data.IsHold, Mode=OneWay}" Command="{Binding Parent.SetHold}" />
                    </Grid>
                  </StackPanel>
                </StackPanel>

                <!-- Views: the same figure from three standard angles -->
                <StackPanel Grid.Column="2" Spacing="10">
                  <TextBlock Text="Views" Style="{StaticResource TypeMicro}" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Tag="iso" Click="OnPresetClick" Style="{StaticResource ConsoleButton}" Width="132" Height="104" Padding="8,6"
                            Background="Transparent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                            AutomationProperties.Name="View isometric">
                      <Grid RowDefinitions="*,Auto">
                        <rendering:SolidThumb PresetKey="iso" Selected="{Binding Data.Selected}" AlertingUnits="{Binding Data.AlertingUnits}" />
                        <TextBlock Grid.Row="1" Style="{StaticResource TypeMicro}"><Run Text="Isometric" Foreground="{StaticResource TextPrimaryBrush}" /><Run Text="  35° · 28°" /></TextBlock>
                      </Grid>
                    </Button>
                    <Button Tag="elevation" Click="OnPresetClick" Style="{StaticResource ConsoleButton}" Width="132" Height="104" Padding="8,6"
                            Background="Transparent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                            AutomationProperties.Name="View elevation">
                      <Grid RowDefinitions="*,Auto">
                        <rendering:SolidThumb PresetKey="elevation" Selected="{Binding Data.Selected}" AlertingUnits="{Binding Data.AlertingUnits}" />
                        <TextBlock Grid.Row="1" Style="{StaticResource TypeMicro}"><Run Text="Elevation" Foreground="{StaticResource TextPrimaryBrush}" /><Run Text="  0° · 6°" /></TextBlock>
                      </Grid>
                    </Button>
                    <Button Tag="plan" Click="OnPresetClick" Style="{StaticResource ConsoleButton}" Width="132" Height="104" Padding="8,6"
                            Background="Transparent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                            AutomationProperties.Name="View plan">
                      <Grid RowDefinitions="*,Auto">
                        <rendering:SolidThumb PresetKey="plan" Selected="{Binding Data.Selected}" AlertingUnits="{Binding Data.AlertingUnits}" />
                        <TextBlock Grid.Row="1" Style="{StaticResource TypeMicro}"><Run Text="Plan" Foreground="{StaticResource TextPrimaryBrush}" /><Run Text="  0° · 86°" /></TextBlock>
                      </Grid>
                    </Button>
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Grid>

            <!-- ============ READINGS: a datasheet column ============ -->
            <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                          Margin="0,0,-12,0" Padding="0,0,12,0"
                          Grid.Column="{utu:Responsive Layout={StaticResource ConsoleLayout}, Normal=0, Wide=1}"
                          Grid.Row="{utu:Responsive Layout={StaticResource ConsoleLayout}, Normal=1, Wide=0}"
                          Grid.ColumnSpan="{utu:Responsive Layout={StaticResource ConsoleLayout}, Normal=2, Wide=1}">
            <StackPanel Spacing="16" AutomationProperties.Name="Readings">

              <!-- Net output: the one display-size figure -->
              <Grid RowDefinitions="Auto,Auto,72" RowSpacing="0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="Net output" Style="{StaticResource TypeSection}" />
                  <Ellipse Width="6" Height="6" controls:Pulse.IsEnabled="True" VerticalAlignment="Center"
                           Fill="{Binding Data.DataIsLive, Converter={StaticResource Tone}, ConverterParameter=True=AccentBrush|False=FaintBrush}" />
                  <TextBlock Text="{Binding Data.LiveText}" Style="{StaticResource TypeMicro}" VerticalAlignment="Center" />
                </StackPanel>
                <Grid Grid.Row="1">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding Data.OutputNow}" Style="{StaticResource TypeHero}" />
                    <TextBlock Text="MW" Style="{StaticResource TypeBody}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom" Margin="0,0,0,12" />
                  </StackPanel>
                  <TextBlock Text="{Binding Data.OutputDelta}" Style="{StaticResource TypeMicro}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,12" />
                </Grid>
                <charts:OutputChart Grid.Row="2" Values="{Binding Data.OutputSeries}" Target="{Binding Data.TargetMw}" />
              </Grid>

              <Border Style="{StaticResource Rule}" />

              <!-- Selected unit: name, state, portrait, then its readings -->
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,112" ColumnSpacing="16">
                  <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource TypeTitle}">
                      <Run Text="{Binding Data.SelectedCode}" /><Run Text="  " /><Run Text="{Binding Data.SelectedName}" FontFamily="{StaticResource SansFont}" />
                    </TextBlock>
                    <TextBlock Text="{Binding Data.SelectedStatusLine}" Style="{StaticResource TypeBody}"
                               Foreground="{Binding Data.SelectedIsAlert, Converter={StaticResource Tone}, ConverterParameter=True=AlertTextBrush|False=InkSoftBrush}" />
                    <TextBlock Style="{StaticResource TypeMicro}">
                      <Run Text="Up " /><Run Text="{Binding Data.SelectedUptime}" /><Run Text=" · serviced " /><Run Text="{Binding Data.SelectedService}" />
                    </TextBlock>
                  </StackPanel>
                  <rendering:SolidThumb Grid.Column="1" Height="76" SingleUnit="True" PresetKey="iso"
                                        Selected="{Binding Data.Selected}" AlertingUnits="{Binding Data.AlertingUnits}" />
                </Grid>
                <ItemsRepeater ItemsSource="{Binding Data.Tiles}">
                  <ItemsRepeater.Layout>
                    <UniformGridLayout MaximumRowsOrColumns="3" MinItemWidth="96" MinItemHeight="46"
                                       MinColumnSpacing="16" MinRowSpacing="8" ItemsStretch="Fill" />
                  </ItemsRepeater.Layout>
                  <ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Spacing="0">
                        <TextBlock Style="{StaticResource TypeMicro}">
                          <Run Text="{Binding Label}" /><Run Text=" " /><Run Text="{Binding Status}" Foreground="{StaticResource AlertTextBrush}" />
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <TextBlock Text="{Binding Value}" Style="{StaticResource TypeValue}"
                                     Foreground="{Binding Tone, Converter={StaticResource Tone}, ConverterParameter=high=AlertTextBrush|held=MutedBrush|normal=TextPrimaryBrush}" />
                          <TextBlock Text="{Binding Unit}" Style="{StaticResource TypeMicro}" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                        </StackPanel>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
              </StackPanel>

              <Border Style="{StaticResource Rule}" />

              <!-- Two plots side by side: the plant's day, the unit's vibration -->
              <Grid ColumnDefinitions="*,*" ColumnSpacing="24">
                <Grid RowDefinitions="Auto,64" RowSpacing="6">
                  <TextBlock Style="{StaticResource TypeMicro}">
                    <Run Text="Hourly generation, MWh" Foreground="{StaticResource TextPrimaryBrush}" /><Run Text="   peak " /><Run Text="{Binding Data.HourlyPeak}" />
                  </TextBlock>
                  <charts:HourlyChart Grid.Row="1" Values="{Binding Data.HourlySeries}" />
                </Grid>
                <Grid Grid.Column="1" RowDefinitions="Auto,64" RowSpacing="6">
                  <TextBlock Style="{StaticResource TypeMicro}">
                    <Run Text="Vibration, mm/s" Foreground="{StaticResource TextPrimaryBrush}" /><Run Text="  " /><Run Text="{Binding Data.VibrationStatus}"
                         Foreground="{Binding Data.VibrationIsHigh, Converter={StaticResource Tone}, ConverterParameter=True=AlertTextBrush|False=MutedBrush}" /><Run Text=" · " /><Run Text="{Binding Data.VibrationZone}" />
                  </TextBlock>
                  <charts:VibrationChart Grid.Row="1" Values="{Binding Data.VibrationSeries}" IsHigh="{Binding Data.VibrationIsHigh}" />
                </Grid>
              </Grid>

              <Border Style="{StaticResource Rule}" />

              <!-- Valves: filled is open, a ring is shut -->
              <StackPanel Spacing="10">
                <TextBlock Style="{StaticResource TypeMicro}">
                  <Run Text="Valves" Foreground="{StaticResource TextPrimaryBrush}" /><Run Text="   " /><Run Text="{Binding Data.OpenValvesText}" /><Run Text=" open" />
                </TextBlock>
                <ItemsRepeater ItemsSource="{Binding Data.Valves}">
                  <ItemsRepeater.Layout>
                    <StackLayout Orientation="Horizontal" Spacing="8" />
                  </ItemsRepeater.Layout>
                  <ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                      <ToggleButton Style="{StaticResource ValveToggleButton}" Width="40" Height="32"
                                    IsChecked="{Binding Open, Mode=OneWay}"
                                    Command="{utu:AncestorBinding AncestorType=Page, Path=DataContext.ToggleValve}"
                                    CommandParameter="{Binding Id}"
                                    AutomationProperties.Name="{Binding AutomationName}"
                                    ToolTipService.ToolTip="{Binding AutomationName}">
                        <TextBlock Text="{Binding Number}" Style="{StaticResource ValveNumber}" HorizontalAlignment="Center" />
                      </ToggleButton>
                    </DataTemplate>
                  </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
              </StackPanel>

              <Border Style="{StaticResource Rule}" />

              <!-- Setpoints -->
              <StackPanel Spacing="10">
                <TextBlock Style="{StaticResource TypeMicro}">
                  <Run Text="Setpoints" Foreground="{StaticResource TextPrimaryBrush}" /><Run Text="   mode " /><Run Text="{Binding Data.ModeText}" />
                </TextBlock>
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="24">
                  <StackPanel Spacing="0">
                    <TextBlock Text="Output target" Style="{StaticResource TypeMicro}" />
                    <TextBlock Style="{StaticResource TypeValue}">
                      <Run Text="{Binding Parent.TargetMw}" /><Run Text=" MW" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                    </TextBlock>
                    <Slider Minimum="400" Maximum="700" StepFrequency="5" SmallChange="5" LargeChange="50"
                            Value="{Binding Parent.TargetMw, Mode=TwoWay}" AutomationProperties.Name="Output target, megawatts" ToolTipService.ToolTip="Dashed line on the output plot" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="0">
                    <TextBlock Text="Turbine inlet limit" Style="{StaticResource TypeMicro}" />
                    <TextBlock Style="{StaticResource TypeValue}">
                      <Run Text="{Binding Parent.TurbineLimitBar}" /><Run Text=" bar" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                    </TextBlock>
                    <Slider Minimum="140" Maximum="180" StepFrequency="1" SmallChange="1" LargeChange="10"
                            Value="{Binding Parent.TurbineLimitBar, Mode=TwoWay}" AutomationProperties.Name="Turbine inlet pressure limit, bar" ToolTipService.ToolTip="TRB-04 alarms above it" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="0">
                    <TextBlock Text="Stack damper" Style="{StaticResource TypeMicro}" />
                    <TextBlock Style="{StaticResource TypeValue}">
                      <Run Text="{Binding Parent.DamperPct}" /><Run Text=" %" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                    </TextBlock>
                    <Slider Minimum="0" Maximum="100" StepFrequency="1" SmallChange="1" LargeChange="10"
                            Value="{Binding Parent.DamperPct, Mode=TwoWay}" AutomationProperties.Name="Stack damper, percent" ToolTipService.ToolTip="Scales STK-01 flow" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </StackPanel>
            </ScrollViewer>
          </Grid>
        </ScrollViewer>
      </Grid>
    </DataTemplate>
  </mvux:FeedView>
</Page>
