<Application x:Class="PacConsole.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:utus="using:Uno.Toolkit.UI.Simple"
             RequestedTheme="Dark">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Load WinUI resources -->
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />

        <!--
          Uno Simple, wrapped by the Simple flavour of the Toolkit styles.
          The console palette is mapped onto Simple's colour roles (colours, not brushes,
          so Simple regenerates hover / pressed / disabled variants). The app is dark only;
          RequestedTheme="Dark" above keeps Simple on its dark dictionaries.
        -->
        <utus:SimpleToolkitTheme>
          <utus:SimpleToolkitTheme.ColorOverrideDictionary>
            <ResourceDictionary>
              <!-- Accent: selection, active controls, output data -->
              <Color x:Key="PrimaryColor">#F5A83B</Color>
              <Color x:Key="OnPrimaryColor">#140C02</Color>
              <Color x:Key="PrimaryContainerColor">#33230B</Color>
              <Color x:Key="OnPrimaryContainerColor">#F5A83B</Color>

              <!-- Cyan: the hologram, nominal status -->
              <Color x:Key="SecondaryColor">#8ADCFF</Color>
              <Color x:Key="OnSecondaryColor">#03070A</Color>
              <Color x:Key="SecondaryContainerColor">#0E2A38</Color>
              <Color x:Key="OnSecondaryContainerColor">#DFF5FF</Color>

              <!-- Ground and card surfaces -->
              <Color x:Key="BackgroundColor">#03070A</Color>
              <Color x:Key="OnBackgroundColor">#DFF5FF</Color>
              <Color x:Key="SurfaceColor">#06131B</Color>
              <Color x:Key="OnSurfaceColor">#DFF5FF</Color>
              <Color x:Key="SurfaceVariantColor">#0A1D28</Color>
              <Color x:Key="OnSurfaceVariantColor">#86AABB</Color>

              <!-- Default cyan border (0.36) and hairline (0.24) over the ground -->
              <Color x:Key="OutlineColor">#5C6ED2FF</Color>
              <Color x:Key="OutlineVariantColor">#3D6ED2FF</Color>

              <!-- Alert -->
              <Color x:Key="ErrorColor">#FF6F61</Color>
              <Color x:Key="OnErrorColor">#140C02</Color>
            </ResourceDictionary>
          </utus:SimpleToolkitTheme.ColorOverrideDictionary>
        </utus:SimpleToolkitTheme>

        <ResourceDictionary Source="ms-appx:///Styles/Tokens.xaml" />
        <ResourceDictionary Source="ms-appx:///Styles/Controls.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

</Application>
