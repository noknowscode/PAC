<Application x:Class="PacConsole.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:utus="using:Uno.Toolkit.UI.Simple"
             RequestedTheme="Light">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Load WinUI resources -->
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />

        <!--
          Uno Simple, wrapped by the Simple flavour of the Toolkit styles. The console palette is
          mapped onto Simple's colour roles (colours, not brushes, so Simple regenerates hover /
          pressed / disabled variants). These are the light base values; the graphite theme repaints
          the app's own token brushes at runtime (ConsoleTheme) and sets the root element theme.
        -->
        <utus:SimpleToolkitTheme>
          <utus:SimpleToolkitTheme.ColorOverrideDictionary>
            <ResourceDictionary>
              <!-- Accent: the one orange indicator (selected, live) -->
              <Color x:Key="PrimaryColor">#C2410C</Color>
              <Color x:Key="OnPrimaryColor">#FFFFFF</Color>
              <Color x:Key="PrimaryContainerColor">#FCEBDF</Color>
              <Color x:Key="OnPrimaryContainerColor">#7A2908</Color>

              <!-- Soft ink: secondary controls -->
              <Color x:Key="SecondaryColor">#3E4B5A</Color>
              <Color x:Key="OnSecondaryColor">#FFFFFF</Color>
              <Color x:Key="SecondaryContainerColor">#E9ECEF</Color>
              <Color x:Key="OnSecondaryContainerColor">#1E2833</Color>

              <!-- Ground and card surfaces -->
              <Color x:Key="BackgroundColor">#F4F5F6</Color>
              <Color x:Key="OnBackgroundColor">#1E2833</Color>
              <Color x:Key="SurfaceColor">#FFFFFF</Color>
              <Color x:Key="OnSurfaceColor">#1E2833</Color>
              <Color x:Key="SurfaceVariantColor">#E9ECEF</Color>
              <Color x:Key="OnSurfaceVariantColor">#5A6573</Color>

              <!-- Control edge (3:1 on the ground) and hairline -->
              <Color x:Key="OutlineColor">#8A939E</Color>
              <Color x:Key="OutlineVariantColor">#D9DDE2</Color>

              <!-- Alert -->
              <Color x:Key="ErrorColor">#B42318</Color>
              <Color x:Key="OnErrorColor">#FFFFFF</Color>
            </ResourceDictionary>
          </utus:SimpleToolkitTheme.ColorOverrideDictionary>
        </utus:SimpleToolkitTheme>

        <ResourceDictionary Source="ms-appx:///Styles/Tokens.xaml" />
        <ResourceDictionary Source="ms-appx:///Styles/Controls.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

</Application>
