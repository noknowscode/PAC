<Application x:Class="PacConsole.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:utus="using:Uno.Toolkit.UI.Simple"
             xmlns:ut="using:Uno.Themes">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Load WinUI resources -->
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />

        <!--
          Uno Simple, wrapped by the Simple flavour of the Toolkit styles. Its colour roles come from the
          console palette, once per theme (ColorOverride.xaml). The theme itself follows the OS until the
          operator picks one; IThemeService applies and saves that choice (SPEC-THEME.md).
        -->
        <utus:SimpleToolkitTheme>
          <utus:SimpleToolkitTheme.Colors>
            <ut:ThemeColors OverrideSource="ms-appx:///Styles/ColorOverride.xaml" />
          </utus:SimpleToolkitTheme.Colors>
        </utus:SimpleToolkitTheme>

        <ResourceDictionary Source="ms-appx:///Styles/Palette.xaml" />
        <ResourceDictionary Source="ms-appx:///Styles/Tokens.xaml" />
        <ResourceDictionary Source="ms-appx:///Styles/Controls.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

</Application>
