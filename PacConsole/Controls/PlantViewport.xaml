<UserControl x:Class="PacConsole.Controls.PlantViewport"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rendering="using:PacConsole.Rendering"
             IsTabStop="True"
             UseSystemFocusVisuals="True"
             FocusVisualPrimaryBrush="{StaticResource AccentBrush}"
             AutomationProperties.Name="Plant 3D model">

  <!-- Fig. 1: the plant sits on the ground with no frame; its caption and tools sit beneath it. -->
  <Grid x:Name="Root" RowDefinitions="*,Auto" RowSpacing="12" Background="Transparent">

    <!-- Drag surface + solid plant. Tags sit in a Canvas above it so they stay real, focusable Buttons. -->
    <Grid x:Name="Surface" Background="Transparent">
      <rendering:PlantCanvas x:Name="PlantDrawing" />
      <Canvas x:Name="TagLayer" />
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="16">
      <!-- Caption, set like a figure plate: number, title, then what the view shows. -->
      <StackPanel Spacing="2" VerticalAlignment="Center" IsHitTestVisible="False">
        <StackPanel Orientation="Horizontal" Spacing="16">
          <TextBlock Style="{StaticResource TypeSection}">
            <Run Text="Fig. 1" Foreground="{StaticResource MutedBrush}" /><Run Text="    Plant 02, thermal" />
          </TextBlock>
          <!-- Circuit legend: the pipe tints, each with its name. -->
          <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <Ellipse Width="10" Height="10" StrokeThickness="1" Stroke="{StaticResource FaintBrush}" Fill="{StaticResource CircuitSteamBrush}" VerticalAlignment="Center" />
              <TextBlock Text="Steam" Style="{StaticResource TypeMicro}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="5">
              <Ellipse Width="10" Height="10" StrokeThickness="1" Stroke="{StaticResource FaintBrush}" Fill="{StaticResource CircuitWaterBrush}" VerticalAlignment="Center" />
              <TextBlock Text="Feedwater" Style="{StaticResource TypeMicro}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="5">
              <Ellipse Width="10" Height="10" StrokeThickness="1" Stroke="{StaticResource FaintBrush}" Fill="{StaticResource CircuitCoolingBrush}" VerticalAlignment="Center" />
              <TextBlock Text="Cooling water" Style="{StaticResource TypeMicro}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="5">
              <Ellipse Width="10" Height="10" StrokeThickness="1" Stroke="{StaticResource FaintBrush}" Fill="{StaticResource CircuitFuelBrush}" VerticalAlignment="Center" />
              <TextBlock Text="Fuel" Style="{StaticResource TypeMicro}" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
        <TextBlock Style="{StaticResource TypeMicro}">
          <Run x:Name="CaptionDetail" /><Run Text=" · drag to orbit, click a unit to select it" />
        </TextBlock>
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
        <Button x:Name="RotateLeft"
                Style="{StaticResource IconButton}"
                AutomationProperties.Name="Rotate left 45 degrees"
                ToolTipService.ToolTip="Rotate left">
          <!-- Fluent "Rotate" glyph, mirrored for the anticlockwise turn. -->
          <FontIcon Glyph="&#xE7AD;" FontSize="16" RenderTransformOrigin="0.5,0.5">
            <FontIcon.RenderTransform>
              <ScaleTransform ScaleX="-1" />
            </FontIcon.RenderTransform>
          </FontIcon>
        </Button>
        <Button x:Name="RotateRight"
                Style="{StaticResource IconButton}"
                AutomationProperties.Name="Rotate right 45 degrees"
                ToolTipService.ToolTip="Rotate right">
          <FontIcon Glyph="&#xE7AD;" FontSize="16" />
        </Button>
        <ToggleButton x:Name="AutoOrbit" Style="{StaticResource ToolbarToggleButton}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse Width="6" Height="6" Fill="{Binding Foreground, ElementName=AutoOrbitLabel}" VerticalAlignment="Center" />
            <TextBlock x:Name="AutoOrbitLabel" Text="Auto orbit" Style="{StaticResource ControlLabel}" VerticalAlignment="Center" />
          </StackPanel>
        </ToggleButton>
        <Button x:Name="Reset" Content="Reset view" Style="{StaticResource ToolbarButton}" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
