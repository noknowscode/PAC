<UserControl x:Class="PacConsole.Controls.PlantViewport"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rendering="using:PacConsole.Rendering"
             xmlns:controls="using:PacConsole.Controls"
             xmlns:utu="using:Uno.Toolkit.UI"
             x:Name="Viewport"
             IsTabStop="True"
             UseSystemFocusVisuals="True"
             FocusVisualPrimaryBrush="{ThemeResource PrimaryBrush}"
             AutomationProperties.Name="Plant 3D model">

  <!--
    The plant panel (SPEC-CONSOLE.md): title, view switcher and the page's systems filter above the drawing, the
    standard views as live thumbnails beside it from 960 px, the circuit legend at its foot, then a footer bar with
    the page's equipment picker and the camera tools. Per category (ConsoleLayout in Layout.xaml):
      Narrow   the switcher takes its own full-width row, the filter wraps below it, and the footer splits into the
               picker row and a row of 44 px camera tools (Reset as an icon).
      Normal   the switcher sits beside the title; the filter wraps on its own row; the footer keeps two rows.
      Wide     thumbnails replace the switcher; the footer is one row of 32 px pointer tools.
      Widest   as Wide; from 1280 px (PlantHeaderLayout) the filter moves beside the title.
    The switcher and the camera tools change shape, so they are ResponsiveViews. Their buttons reach the viewport by
    binding (template content has no fields): each view segment and thumbnail binds RestingPreset two-way, the orbit
    toggle IsAutoOrbit, and the camera tools its commands.
  -->
  <UserControl.Resources>
    <controls:PresetConverter x:Key="PresetIs" />
  </UserControl.Resources>
  <Grid x:Name="Root" RowDefinitions="Auto,*,Auto" Background="Transparent">

    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="{StaticResource Space250}"
          Padding="{utu:Responsive Layout={StaticResource ConsoleLayout}, Narrow={StaticResource PanelHeaderInsetNarrow}, Normal={StaticResource PanelHeaderInset}}">
      <StackPanel Spacing="{StaticResource Space025}" VerticalAlignment="Center" IsHitTestVisible="False">
        <TextBlock x:Name="TitleText" Style="{StaticResource TypeSection}" />
        <TextBlock Text="Drag to orbit · Select an assembly" Style="{StaticResource TypeMicro}" TextWrapping="WrapWholeWords" />
      </StackPanel>

      <!-- Standard views: one raised segment shows the view the camera rests in. Thumbnails take over from 960 px. -->
      <utu:ResponsiveView IsTabStop="False" ResponsiveLayout="{StaticResource ConsoleLayout}" VerticalAlignment="Top" HorizontalContentAlignment="Stretch"
                          AutomationProperties.Name="Standard views"
                          Grid.Row="{utu:Responsive Layout={StaticResource ConsoleLayout}, Narrow=1, Normal=0}"
                          Grid.Column="{utu:Responsive Layout={StaticResource ConsoleLayout}, Narrow=0, Normal=2}"
                          Grid.ColumnSpan="{utu:Responsive Layout={StaticResource ConsoleLayout}, Narrow=3, Normal=1}"
                          Margin="{utu:Responsive Layout={StaticResource ConsoleLayout}, Narrow={StaticResource Space125TopThickness}, Normal={StaticResource Space0Thickness}}"
                          Visibility="{utu:Responsive Layout={StaticResource ConsoleLayout}, Narrow=Visible, Wide=Collapsed}">
        <!-- Phone: three equal segments across the panel. -->
        <utu:ResponsiveView.NarrowTemplate>
          <DataTemplate>
            <!-- xaml-lint: allow card - the segmented control's track, not a content surface (same as the page's Mode and range tracks). -->
            <Border Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource OutlineVariantBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius200CornerRadius}" Padding="{StaticResource Space050Thickness}">
              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="{StaticResource Space025}">
                <RadioButton GroupName="PlantView" Style="{StaticResource ViewRadioButtonTouch}"
                             IsChecked="{Binding RestingPreset, ElementName=Viewport, Mode=TwoWay, Converter={StaticResource PresetIs}, ConverterParameter=iso}" AutomationProperties.Name="Isometric view">
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space075}">
                    <FontIcon Glyph="&#xE7B8;" FontSize="{StaticResource IconSizeSmall}" />
                    <TextBlock Text="Isometric" Style="{StaticResource ControlLabel}" VerticalAlignment="Center" />
                  </StackPanel>
                </RadioButton>
                <RadioButton Grid.Column="1" GroupName="PlantView" Style="{StaticResource ViewRadioButtonTouch}"
                             IsChecked="{Binding RestingPreset, ElementName=Viewport, Mode=TwoWay, Converter={StaticResource PresetIs}, ConverterParameter=elevation}" AutomationProperties.Name="Elevation view">
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space075}">
                    <FontIcon Glyph="&#xE7C3;" FontSize="{StaticResource IconSizeSmall}" />
                    <TextBlock Text="Elevation" Style="{StaticResource ControlLabel}" VerticalAlignment="Center" />
                  </StackPanel>
                </RadioButton>
                <RadioButton Grid.Column="2" GroupName="PlantView" Style="{StaticResource ViewRadioButtonTouch}"
                             IsChecked="{Binding RestingPreset, ElementName=Viewport, Mode=TwoWay, Converter={StaticResource PresetIs}, ConverterParameter=plan}" AutomationProperties.Name="Plan view">
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space075}">
                    <FontIcon Glyph="&#xE8A9;" FontSize="{StaticResource IconSizeSmall}" />
                    <TextBlock Text="Plan" Style="{StaticResource ControlLabel}" VerticalAlignment="Center" />
                  </StackPanel>
                </RadioButton>
              </Grid>
            </Border>
          </DataTemplate>
        </utu:ResponsiveView.NarrowTemplate>
        <!-- Tablet: a compact switcher beside the title, still with 44 px segments. -->
        <utu:ResponsiveView.NormalTemplate>
          <DataTemplate>
            <!-- xaml-lint: allow card - the segmented control's track, not a content surface. -->
            <Border Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource OutlineVariantBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius200CornerRadius}" Padding="{StaticResource Space050Thickness}">
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space025}">
                <RadioButton GroupName="PlantView" Style="{StaticResource ViewRadioButtonTouch}"
                             IsChecked="{Binding RestingPreset, ElementName=Viewport, Mode=TwoWay, Converter={StaticResource PresetIs}, ConverterParameter=iso}" AutomationProperties.Name="Isometric view">
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space075}">
                    <FontIcon Glyph="&#xE7B8;" FontSize="{StaticResource IconSizeSmall}" />
                    <TextBlock Text="Isometric" Style="{StaticResource ControlLabel}" VerticalAlignment="Center" />
                  </StackPanel>
                </RadioButton>
                <RadioButton GroupName="PlantView" Style="{StaticResource ViewRadioButtonTouch}"
                             IsChecked="{Binding RestingPreset, ElementName=Viewport, Mode=TwoWay, Converter={StaticResource PresetIs}, ConverterParameter=elevation}" AutomationProperties.Name="Elevation view">
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space075}">
                    <FontIcon Glyph="&#xE7C3;" FontSize="{StaticResource IconSizeSmall}" />
                    <TextBlock Text="Elevation" Style="{StaticResource ControlLabel}" VerticalAlignment="Center" />
                  </StackPanel>
                </RadioButton>
                <RadioButton GroupName="PlantView" Style="{StaticResource ViewRadioButtonTouch}"
                             IsChecked="{Binding RestingPreset, ElementName=Viewport, Mode=TwoWay, Converter={StaticResource PresetIs}, ConverterParameter=plan}" AutomationProperties.Name="Plan view">
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space075}">
                    <FontIcon Glyph="&#xE8A9;" FontSize="{StaticResource IconSizeSmall}" />
                    <TextBlock Text="Plan" Style="{StaticResource ControlLabel}" VerticalAlignment="Center" />
                  </StackPanel>
                </RadioButton>
              </StackPanel>
            </Border>
          </DataTemplate>
        </utu:ResponsiveView.NormalTemplate>
      </utu:ResponsiveView>

      <!-- The page's systems filter: it wraps, so it never runs past the panel edge. -->
      <ContentPresenter x:Name="HeaderHost" VerticalAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Grid.Row="{utu:Responsive Layout={StaticResource PlantHeaderLayout}, Narrow=2, Normal=1, Wide=0}"
                        Grid.Column="{utu:Responsive Layout={StaticResource PlantHeaderLayout}, Narrow=0, Wide=1}"
                        Grid.ColumnSpan="{utu:Responsive Layout={StaticResource PlantHeaderLayout}, Narrow=3, Wide=1}"
                        Margin="{utu:Responsive Layout={StaticResource PlantHeaderLayout}, Narrow={StaticResource Space125TopThickness}, Wide={StaticResource Space0Thickness}}" />
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
      <!-- Drag surface + solid plant. Tags sit in a Canvas above it so they stay real, focusable Buttons. Below 960 px
           the panel sizes to its rows, and the drawing keeps at least this height. -->
      <Grid x:Name="Surface" Background="Transparent"
            MinHeight="{utu:Responsive Layout={StaticResource ConsoleLayout}, Narrow={StaticResource PlantDrawingMinHeightNarrow}, Normal={StaticResource PlantDrawingMinHeightNormal}, Wide=0}">
        <rendering:PlantCanvas x:Name="PlantDrawing" />
        <Canvas x:Name="TagLayer" />

        <!-- Circuit legend: the pipe tints, each with its name. -->
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space150}" VerticalAlignment="Bottom" HorizontalAlignment="Left" IsHitTestVisible="False"
                    Margin="{utu:Responsive Layout={StaticResource ConsoleLayout}, Narrow={StaticResource LegendMarginNarrow}, Normal={StaticResource LegendMargin}}">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space075}">
            <Ellipse Width="{StaticResource DotSizeLegend}" Height="{StaticResource DotSizeLegend}" Fill="{ThemeResource CircuitSteamBrush}" VerticalAlignment="Center" />
            <TextBlock Text="Steam" Style="{StaticResource TypeMicro}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space075}">
            <Ellipse Width="{StaticResource DotSizeLegend}" Height="{StaticResource DotSizeLegend}" Fill="{ThemeResource CircuitWaterBrush}" VerticalAlignment="Center" />
            <TextBlock Text="Feedwater" Style="{StaticResource TypeMicro}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space075}">
            <Ellipse Width="{StaticResource DotSizeLegend}" Height="{StaticResource DotSizeLegend}" Fill="{ThemeResource CircuitCoolingBrush}" VerticalAlignment="Center" />
            <TextBlock Text="Cooling water" Style="{StaticResource TypeMicro}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space075}">
            <Ellipse Width="{StaticResource DotSizeLegend}" Height="{StaticResource DotSizeLegend}" Fill="{ThemeResource CircuitFuelBrush}" VerticalAlignment="Center" />
            <TextBlock Text="Fuel" Style="{StaticResource TypeMicro}" />
          </StackPanel>
        </StackPanel>
      </Grid>

      <!-- The standard views beside the drawing, live: each shows the plant from its camera with the same
           selection, alerts and system; choosing one moves the main camera there. -->
      <StackPanel Grid.Column="1" Spacing="{StaticResource Space125}" Margin="{StaticResource ThumbColumnMargin}" VerticalAlignment="Top"
                  AutomationProperties.Name="Standard views"
                  Visibility="{utu:Responsive Layout={StaticResource ConsoleLayout}, Narrow=Collapsed, Wide=Visible}">
        <RadioButton GroupName="PlantThumbs"
                     IsChecked="{Binding RestingPreset, ElementName=Viewport, Mode=TwoWay, Converter={StaticResource PresetIs}, ConverterParameter=iso}" Style="{StaticResource ThumbRadioButton}" Width="{StaticResource ThumbWidth}" AutomationProperties.Name="Isometric view">
          <Grid RowDefinitions="Auto,Auto">
            <rendering:PlantThumb x:Name="ThumbIsoDrawing" PresetKey="iso" Height="{StaticResource ThumbDrawingHeight}" IsHitTestVisible="False" />
            <TextBlock Grid.Row="1" Text="Isometric" Style="{StaticResource ControlLabel}" Margin="{StaticResource ThumbLabelMargin}" />
          </Grid>
        </RadioButton>
        <RadioButton GroupName="PlantThumbs"
                     IsChecked="{Binding RestingPreset, ElementName=Viewport, Mode=TwoWay, Converter={StaticResource PresetIs}, ConverterParameter=elevation}" Style="{StaticResource ThumbRadioButton}" Width="{StaticResource ThumbWidth}" AutomationProperties.Name="Elevation view">
          <Grid RowDefinitions="Auto,Auto">
            <rendering:PlantThumb x:Name="ThumbElevationDrawing" PresetKey="elevation" Height="{StaticResource ThumbDrawingHeight}" IsHitTestVisible="False" />
            <TextBlock Grid.Row="1" Text="Elevation" Style="{StaticResource ControlLabel}" Margin="{StaticResource ThumbLabelMargin}" />
          </Grid>
        </RadioButton>
        <RadioButton GroupName="PlantThumbs"
                     IsChecked="{Binding RestingPreset, ElementName=Viewport, Mode=TwoWay, Converter={StaticResource PresetIs}, ConverterParameter=plan}" Style="{StaticResource ThumbRadioButton}" Width="{StaticResource ThumbWidth}" AutomationProperties.Name="Plan view">
          <Grid RowDefinitions="Auto,Auto">
            <rendering:PlantThumb x:Name="ThumbPlanDrawing" PresetKey="plan" Height="{StaticResource ThumbDrawingHeight}" IsHitTestVisible="False" />
            <TextBlock Grid.Row="1" Text="Plan" Style="{StaticResource ControlLabel}" Margin="{StaticResource ThumbLabelMargin}" />
          </Grid>
        </RadioButton>
      </StackPanel>
    </Grid>

    <Border Grid.Row="2" BorderBrush="{ThemeResource OutlineVariantBrush}" BorderThickness="0,1,0,0"
            Padding="{utu:Responsive Layout={StaticResource ConsoleLayout}, Narrow={StaticResource PanelFooterInsetNarrow}, Normal={StaticResource PanelFooterInset}}">
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Space200}">
        <ContentPresenter x:Name="FooterHost" VerticalAlignment="Center" HorizontalContentAlignment="Stretch"
                          Grid.ColumnSpan="{utu:Responsive Layout={StaticResource ConsoleLayout}, Narrow=2, Wide=1}" />

        <!-- Camera tools: their own row of touch targets below 960 px, beside the picker from Wide up. -->
        <utu:ResponsiveView IsTabStop="False" ResponsiveLayout="{StaticResource ConsoleLayout}" VerticalAlignment="Center"
                            Grid.Row="{utu:Responsive Layout={StaticResource ConsoleLayout}, Narrow=1, Wide=0}"
                            Grid.Column="{utu:Responsive Layout={StaticResource ConsoleLayout}, Narrow=0, Wide=1}"
                            Grid.ColumnSpan="{utu:Responsive Layout={StaticResource ConsoleLayout}, Narrow=2, Wide=1}"
                            Margin="{utu:Responsive Layout={StaticResource ConsoleLayout}, Narrow={StaticResource Space100TopThickness}, Wide={StaticResource Space0Thickness}}">
          <utu:ResponsiveView.NarrowTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space050}" AutomationProperties.Name="Camera">
                <ToggleButton Style="{StaticResource ToolbarToggleButtonTouch}" AutomationProperties.Name="Auto orbit"
                              IsChecked="{Binding IsAutoOrbit, ElementName=Viewport, Mode=TwoWay}">
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space100}">
                    <Ellipse Width="{StaticResource DotSizeLive}" Height="{StaticResource DotSizeLive}" Fill="{Binding Foreground, ElementName=OrbitLabel}" VerticalAlignment="Center" />
                    <TextBlock x:Name="OrbitLabel" Text="{utu:AncestorBinding AncestorType=controls:PlantViewport, Path=OrbitStatus}" Style="{StaticResource ControlLabel}" VerticalAlignment="Center" />
                  </StackPanel>
                </ToggleButton>
                <Button Style="{StaticResource IconButtonTouch}" Command="{Binding RotateLeftCommand, ElementName=Viewport}"
                        AutomationProperties.Name="Rotate left 45 degrees" ToolTipService.ToolTip="Rotate left">
                  <!-- Fluent "Rotate" glyph, mirrored for the anticlockwise turn. -->
                  <FontIcon Glyph="&#xE7AD;" FontSize="{StaticResource IconSizeSmall}" RenderTransformOrigin="0.5,0.5">
                    <FontIcon.RenderTransform>
                      <ScaleTransform ScaleX="-1" />
                    </FontIcon.RenderTransform>
                  </FontIcon>
                </Button>
                <Button Style="{StaticResource IconButtonTouch}" Command="{Binding RotateRightCommand, ElementName=Viewport}"
                        AutomationProperties.Name="Rotate right 45 degrees" ToolTipService.ToolTip="Rotate right">
                  <FontIcon Glyph="&#xE7AD;" FontSize="{StaticResource IconSizeSmall}" />
                </Button>
                <!-- Below 600 px the label goes and the Home glyph carries Reset; its name still says it. -->
                <Button Style="{StaticResource ToolbarButtonTouch}" Command="{Binding ResetViewCommand, ElementName=Viewport}" AutomationProperties.Name="Reset view"
                        ToolTipService.ToolTip="Back to the isometric view (Home)">
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space100}">
                    <FontIcon Glyph="&#xE80F;" FontSize="{StaticResource IconSizeSmall}" />
                    <TextBlock Text="Reset view" Style="{StaticResource ControlLabel}" VerticalAlignment="Center"
                               Visibility="{utu:Responsive Layout={StaticResource ConsoleLayout}, Narrow=Collapsed, Normal=Visible}" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </DataTemplate>
          </utu:ResponsiveView.NarrowTemplate>
          <utu:ResponsiveView.WideTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space050}" AutomationProperties.Name="Camera">
                <ToggleButton Style="{StaticResource ToolbarToggleButton}" AutomationProperties.Name="Auto orbit"
                              IsChecked="{Binding IsAutoOrbit, ElementName=Viewport, Mode=TwoWay}">
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space100}">
                    <Ellipse Width="{StaticResource DotSizeLive}" Height="{StaticResource DotSizeLive}" Fill="{Binding Foreground, ElementName=OrbitLabel}" VerticalAlignment="Center" />
                    <TextBlock x:Name="OrbitLabel" Text="{utu:AncestorBinding AncestorType=controls:PlantViewport, Path=OrbitStatus}" Style="{StaticResource ControlLabel}" VerticalAlignment="Center" />
                  </StackPanel>
                </ToggleButton>
                <Button Style="{StaticResource IconButton}" Command="{Binding RotateLeftCommand, ElementName=Viewport}"
                        AutomationProperties.Name="Rotate left 45 degrees" ToolTipService.ToolTip="Rotate left">
                  <FontIcon Glyph="&#xE7AD;" FontSize="{StaticResource IconSizeSmall}" RenderTransformOrigin="0.5,0.5">
                    <FontIcon.RenderTransform>
                      <ScaleTransform ScaleX="-1" />
                    </FontIcon.RenderTransform>
                  </FontIcon>
                </Button>
                <Button Style="{StaticResource IconButton}" Command="{Binding RotateRightCommand, ElementName=Viewport}"
                        AutomationProperties.Name="Rotate right 45 degrees" ToolTipService.ToolTip="Rotate right">
                  <FontIcon Glyph="&#xE7AD;" FontSize="{StaticResource IconSizeSmall}" />
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding ResetViewCommand, ElementName=Viewport}" AutomationProperties.Name="Reset view"
                        ToolTipService.ToolTip="Back to the isometric view (Home)">
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space100}">
                    <!-- Fluent "Home": the camera's home pose, the same as the Home key. -->
                    <FontIcon Glyph="&#xE80F;" FontSize="{StaticResource IconSizeSmall}" />
                    <TextBlock Text="Reset view" Style="{StaticResource ControlLabel}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </DataTemplate>
          </utu:ResponsiveView.WideTemplate>
        </utu:ResponsiveView>
      </Grid>
    </Border>
  </Grid>
</UserControl>
