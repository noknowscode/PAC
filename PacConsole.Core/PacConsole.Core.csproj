<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pure domain + math for the PAC console: records, plant geometry, camera projection,
    tag layout, simulated telemetry and alert rules. No UI types, so every rule is unit-testable.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PacConsole.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- DepthOrder.Separable, the invariant the depth order relies on, is checked against the plant by the tests. -->
    <InternalsVisibleTo Include="PacConsole.Tests" />
  </ItemGroup>

</Project>
