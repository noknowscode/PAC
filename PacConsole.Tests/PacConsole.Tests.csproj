<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!--
      UNOB0025: the tests run the app's plain net10.0 build on Uno's reference assemblies on purpose. They drive the
      page model (MVUX states and commands), the persistence store and the renderer offscreen, and never start the
      Uno runtime or a window.
    -->
    <UnoDisableUNOB0025Validation>true</UnoDisableUNOB0025Validation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PacConsole.Core\PacConsole.Core.csproj" />
    <ProjectReference Include="..\PacConsole\PacConsole.csproj" />
  </ItemGroup>
</Project>
